+  "title": "Scope Overlap Report",
+  "description": "Produced by the scope placement check (design-generation-skill.md Step 2b) before any new design starts. Compares an incoming brief (from a PRD, ticket, or feature request) against every project in the design index and decides whether the work is genuinely new, belongs to an existing design, relates to one that must stay consistent, or should be split across several. The same idea as the component similarity check, one level up: reuse whole designs before creating new ones.",
+  "type": "object",
+  "required": ["id", "briefRef", "generatedAt", "candidates", "elementRouting", "recommendation"],
+  "properties": {
+    "id": { "type": "string", "description": "e.g. 'PRD-031-scope-1'." },
+    "briefRef": { "type": "string", "description": "ticketKey of the brief being placed." },
+    "generatedAt": { "type": "string", "format": "date-time" },
+
+    "candidates": {
+      "type": "array",
+      "description": "Every design-index project that scored above zero, highest first. Projects scoring 0 are omitted.",
+      "items": {
+        "type": "object",
+        "required": ["projectId", "score", "classification", "evidence"],
+        "properties": {
+          "projectId": { "type": "string" },
+          "termOverlap": { "type": "number", "minimum": 0, "maximum": 1, "description": "Jaccard of brief.scopeTerms vs project.scopeTerms." },
+          "surfaceOverlap": { "type": "number", "minimum": 0, "maximum": 1, "description": "Jaccard of brief.surfaces vs project.surfaces (a parent surface matches its children, e.g. 'dashboard' matches 'dashboard/toolbar')." },
+          "priorityOverlap": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fraction of the brief's priorities that an existing project priority already serves. Judged by the agent, so every match must be listed in evidence." },
+          "score": { "type": "number", "minimum": 0, "maximum": 1, "description": "Weighted per scopePolicy.overlapCheck.weights in the manifest." },
+          "classification": {
+            "type": "string",
+            "enum": ["belongs-to-existing", "related", "unrelated"],
+            "description": "score >= mergeThreshold -> belongs-to-existing; score >= relatedThreshold -> related; else unrelated. A deprecated project is never classified belongs-to-existing."
+          },
+          "evidence": {
+            "type": "array",
+            "items": { "type": "string" },
+            "description": "Concrete matches that produced the score — shared terms, shared surfaces, and each brief-priority → project-priority pairing. No score without evidence."
+          }
+        }
+      }
+    },
+
+    "elementRouting": {
+      "type": "array",
+      "description": "Per-element placement. A brief can be partly new and partly someone else's scope — routing each requiredElement individually is how a split is detected.",
+      "items": {
+        "type": "object",
+        "required": ["element", "route"],
+        "properties": {
+          "element": { "type": "string", "description": "The requiredElements[].description or priority id being routed." },
+          "route": {
+            "type": "string",
+            "enum": ["this-project", "existing-project", "reuse-pattern-from"],
+            "description": "'existing-project' = this work should be done as a revision of targetProjectId. 'reuse-pattern-from' = do it here, but reuse targetProjectId's approved decision/components so the two stay consistent."
+          },
+          "targetProjectId": { "type": "string" },
+          "reason": { "type": "string" }
+        }
+      }
+    },
+
+    "recommendation": {
+      "type": "string",
+      "enum": ["new-project", "extend-existing", "split", "new-project-with-shared-patterns"],
+      "description": "'new-project' = nothing overlaps meaningfully. 'extend-existing' = the whole brief belongs to targetProjectId. 'split' = some elements belong elsewhere (see elementRouting). 'new-project-with-shared-patterns' = new, but must reuse decisions/components from related projects."
+    },
+    "targetProjectId": { "type": "string", "description": "Set when recommendation is extend-existing." },
+    "reusedDecisions": {
+      "type": "array",
+      "description": "Decision-log entries from related projects that this brief should inherit rather than re-decide — e.g. the approved date-range filter pattern.",
+      "items": {
+        "type": "object",
+        "required": ["projectId", "decision"],
+        "properties": {
+          "projectId": { "type": "string" },
+          "decision": { "type": "string" },
+          "chosen": { "type": "string" }
+        }
+      }
+    },
+    "humanDecision": {
+      "type": "object",
+      "description": "Filled in once the recommendation has been confirmed or overridden, per scopePolicy.onOverlap.",
+      "properties": {
+        "outcome": { "type": "string", "enum": ["accepted", "overridden"] },
+        "finalRecommendation": { "type": "string", "enum": ["new-project", "extend-existing", "split", "new-project-with-shared-patterns"] },
+        "note": { "type": "string" }
+      }
+    }
+  }
+}
diff --git a/.claude/design-agent/schemas/screenshot-set.schema.json b/.claude/design-agent/schemas/screenshot-set.schema.json
new file mode 100644
index 0000000..729fd64
--- /dev/null
+++ b/.claude/design-agent/schemas/screenshot-set.schema.json
@@ -0,0 +1,66 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "$id": "https://example.com/schemas/screenshot-set.schema.json",
+  "title": "Screenshot Set",
+  "description": "A set of screenshots with their context and, when the agent rendered them, what it measured. 'rendered' sets come from tools/screenshots.py; 'provided' sets record screenshots people gave the agent. See skills/design-agent/reference/screenshot-review.md.",
+  "type": "object",
+  "required": ["id", "source", "shots"],
+  "properties": {
+    "id": { "type": "string" },
+    "source": { "type": "string", "enum": ["rendered", "provided"] },
+    "target": { "type": "string", "description": "The page or URL rendered, or what the provided screenshots show." },
+    "capturedAt": { "type": "string" },
+    "manifestVersion": { "type": ["string", "null"] },
+    "shots": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": ["file"],
+        "properties": {
+          "file": { "type": "string" },
+          "viewport": {
+            "type": "object",
+            "properties": {
+              "name": { "type": "string" },
+              "w": { "type": ["integer", "null"], "description": "CSS px. For a provided screenshot, image width ÷ pixel density; null if unknown." },
+              "h": { "type": ["integer", "null"] }
+            }
+          },
+          "imagePx": { "type": "object", "properties": { "w": { "type": "integer" }, "h": { "type": "integer" } } },
+          "pixelDensity": { "type": ["number", "null"], "description": "e.g. 3 for a phone screenshot at 3×. null = unknown: ask." },
+          "textScalePercent": { "type": ["integer", "null"] },
+          "method": { "type": "string", "description": "How the text scale was applied, e.g. 'root font-size'." },
+          "theme": { "type": ["string", "null"] },
+          "state": { "type": ["string", "null"], "description": "Which state it shows: empty, loading, error, signed out…" },
+          "overflowPx": { "type": "integer" }
+        }
+      }
+    },
+    "computedInventory": {
+      "type": "object",
+      "description": "Rendered sets: the measured padding and type of every component, in the audit report's consistencyInventory shape."
+    },
+    "findings": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": ["severity", "category", "rubricItem", "description", "evidence"],
+        "properties": {
+          "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
+          "category": { "type": "string" },
+          "rubricItem": { "type": "string" },
+          "description": { "type": "string" },
+          "evidence": {
+            "type": "object",
+            "required": ["kind", "measured"],
+            "properties": {
+              "kind": { "type": "string", "enum": ["rendered-measurement", "screenshot", "code", "artifact"] },
+              "ref": { "type": "string" },
+              "measured": { "type": "boolean", "description": "false = estimated from an image; such a finding is at most major." }
+            }
+          }
+        }
+      }
+    }
+  }
+}
diff --git a/.claude/design-agent/schemas/ticket-brief.schema.json b/.claude/design-agent/schemas/ticket-brief.schema.json
new file mode 100644
index 0000000..61bd5ba
--- /dev/null
+++ b/.claude/design-agent/schemas/ticket-brief.schema.json
@@ -0,0 +1,176 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "$id": "https://example.com/schemas/ticket-brief.schema.json",
+  "title": "Ticket Brief",
+  "description": "Structured extraction from a Jira ticket, PRD, or feature request, produced before generation starts. Keeps 'what does the ticket actually ask for' explicit and separate from the agent's interpretation, so requireTicketPriorityTraceability (composition-heuristics) has something concrete to check against.",
+  "type": "object",
+  "required": ["ticketKey", "title", "sourceType", "priorities", "requiredElements", "scopeTerms", "surfaces"],
+  "definitions": {
+    "operation": {
+      "type": "object",
+      "required": ["handledBy"],
+      "properties": {
+        "handledBy": { "type": "string", "enum": ["this-project", "existing-design", "new-brief", "out-of-scope", "question"] },
+        "ref": { "type": "string", "description": "existing-design: its design-index ID. new-brief: the new brief's title. out-of-scope: the reason. question: the question." },
+        "note": { "type": "string" }
+      },
+      "allOf": [
+        { "if": { "properties": { "handledBy": { "enum": ["existing-design", "new-brief", "out-of-scope", "question"] } } }, "then": { "required": ["ref"] } }
+      ]
+    }
+  },
+  "properties": {
+    "ticketKey": { "type": "string", "description": "e.g. 'DES-512' or 'PRD-031'." },
+    "sourceType": {
+      "type": "string",
+      "enum": ["jira-ticket", "prd", "page-brief", "feature-request", "other"],
+      "description": "Where this brief came from. 'page-brief' = written from templates/page-brief.md. A PRD often spans several designs, so it is the most common source of scope overlap — see the scope placement check."
+    },
+    "sourceRef": { "type": "string", "description": "Link or path to the source ticket/PRD." },
+    "scopeTerms": {
+      "type": "array",
+      "items": { "type": "string" },
+      "description": "Normalized domain terms this brief is about (lowercase, singular, specific — e.g. 'date-range filter', not 'filter'). Compared against design-index projects' scopeTerms in the scope placement check."
+    },
+    "surfaces": {
+      "type": "array",
+      "items": { "type": "string" },
+      "description": "Screens/areas of the product this brief would change, e.g. ['reports', 'reports/toolbar']. Use the same surface names as the design index."
+    },
+    "scopeOverlapReportRef": { "type": "string", "description": "ID of the scope-overlap-report produced for this brief, once the scope placement check has run." },
+    "title": { "type": "string" },
+    "rawDescription": { "type": "string", "description": "Verbatim (paraphrased per copyright practice if fetched from Jira text) ticket description, kept for traceability." },
+    "priorities": {
+      "type": "array",
+      "description": "The core things this design must accomplish, ranked. Every major generation decision must cite one of these.",
+      "items": {
+        "type": "object",
+        "required": ["id", "statement"],
+        "properties": {
+          "id": { "type": "string", "description": "e.g. 'P1'." },
+          "statement": { "type": "string" },
+          "source": { "type": "string", "enum": ["explicit", "acceptance-criterion", "inferred"], "description": "'explicit' = stated directly in the ticket. 'acceptance-criterion' = derived from a listed AC. 'inferred' = the agent's read on unstated intent — flagged separately so it can be confirmed rather than assumed." }
+        }
+      }
+    },
+    "requiredElements": {
+      "type": "array",
+      "description": "Concrete UI needs pulled from the ticket, each destined for the reuse/similarity check against the manifest's components[].",
+      "items": {
+        "type": "object",
+        "required": ["description", "targetCategory"],
+        "properties": {
+          "description": { "type": "string", "description": "e.g. 'a way to show 4 KPIs with trend indicators'." },
+          "targetCategory": { "type": "string", "enum": ["action", "input", "display", "feedback", "navigation", "layout", "overlay", "data-viz"] },
+          "linkedPriority": { "type": "string", "description": "id of the priority this element serves, for traceability." },
+          "states": { "type": "array", "items": { "type": "string", "enum": ["loading", "empty", "error", "success", "partial"] }, "description": "States this element must show, from the brief's States section." },
+          "estimatedVolume": { "type": "string", "description": "If this is a list/collection, rough expected item count — feeds compositionHeuristics.listPaginationThreshold check, e.g. '~30 rows, grows over time'." }
+        }
+      }
+    },
+    "acceptanceCriteria": {
+      "type": "array",
+      "description": "Testable statements the design must meet, from the brief (optimized by skills/design-agent/reference/brief-optimization.md). Each is checked against the design output in the audit (rubric category 9).",
+      "items": {
+        "type": "object",
+        "required": ["id", "statement"],
+        "properties": {
+          "id": { "type": "string", "description": "e.g. 'AC1'." },
+          "statement": { "type": "string", "description": "Subject, action and measurable result, e.g. 'An admin can turn off email for one event type in 2 taps or fewer, at 320px.'" },
+          "linkedPriority": { "type": "string" },
+          "linkedTask": { "type": "string" },
+          "source": { "type": "string", "enum": ["explicit", "rewritten", "inferred"], "description": "'rewritten' = the author's criterion made testable; 'inferred' = added from a design-system requirement and confirmed by the author." }
+        }
+      }
+    },
+    "connections": {
+      "type": "object",
+      "description": "Where the page fits in the product, from the page brief's 'Where it fits' section. The starting point for the user flow (Step 2c).",
+      "properties": {
+        "arrivesFrom": { "type": "array", "items": { "type": "string" } },
+        "goesNext": { "type": "array", "items": { "type": "string" } },
+        "mustLinkHere": { "type": "array", "items": { "type": "string" }, "description": "Existing pages that should link to this one." }
+      }
+    },
+    "entities": {
+      "type": "array",
+      "description": "The things this page shows, acts on or needs, and who handles each part of their life (skills/design-agent/reference/edge-case-sweep.md, Step 1). This is where missing parts of the product surface, like an admin side nobody briefed.",
+      "items": {
+        "type": "object",
+        "required": ["name", "operations"],
+        "properties": {
+          "name": { "type": "string", "description": "e.g. 'hackathon', 'game', 'vote'." },
+          "description": { "type": "string" },
+          "operations": {
+            "type": "object",
+            "required": ["create", "source"],
+            "properties": {
+              "create": { "$ref": "#/definitions/operation" },
+              "source": { "$ref": "#/definitions/operation" },
+              "update": { "$ref": "#/definitions/operation" },
+              "publish": { "$ref": "#/definitions/operation" },
+              "close": { "$ref": "#/definitions/operation" },
+              "delete": { "$ref": "#/definitions/operation" }
+            }
+          }
+        }
+      }
+    },
+    "nonEntityTerms": {
+      "type": "array",
+      "items": { "type": "string" },
+      "description": "Scope terms that aren't things with a life of their own (e.g. 'voting window'), so the edge-case check doesn't ask who creates them."
+    },
+    "edgeCases": {
+      "type": "array",
+      "description": "The edge-case sweep's findings (skills/design-agent/reference/edge-case-sweep.md, Step 2), each with a decision.",
+      "items": {
+        "type": "object",
+        "required": ["id", "lens", "case", "disposition"],
+        "properties": {
+          "id": { "type": "string", "description": "e.g. 'EC1'." },
+          "lens": { "type": "string", "description": "One of the standard lenses (ecosystem, roles, setup, time, concurrency, integrity, scale, failure, ending, communication, privacy, access) or a product lens from briefPolicy.edgeCaseLenses." },
+          "case": { "type": "string" },
+          "disposition": { "type": "string", "enum": ["in-scope", "new-brief", "out-of-scope", "question", "not-applicable"] },
+          "action": { "type": "string", "description": "in-scope: which AC, element, state or flow path covers it (by id where there is one). new-brief: the brief's title. out-of-scope / not-applicable: the reason. question: the question." }
+        }
+      }
+    },
+    "outOfScope": {
+      "type": "array",
+      "items": { "type": "string" },
+      "description": "What the page deliberately doesn't do. The design must not include these."
+    },
+    "approvedBy": { "type": "string", "description": "Who approved the optimized brief. In lite mode this replaces a separate brief-optimization report." },
+    "optimizationReportRef": { "type": "string", "description": "The brief-optimization-report that produced this brief from its source." },
+    "coreTasks": {
+      "type": "array",
+      "description": "The tasks users come to this design to do. Each is walked against the 3-3-3 rule (design-principles.md) — understood in 3 seconds, reached in 3 clicks, completed in 3 minutes.",
+      "items": {
+        "type": "object",
+        "required": ["id", "statement", "entryPoint"],
+        "properties": {
+          "id": { "type": "string", "description": "e.g. 'T1'." },
+          "statement": { "type": "string", "description": "What the user is trying to get done, e.g. 'Filter the dashboard to the last 30 days.'" },
+          "linkedPriority": { "type": "string" },
+          "entryPoint": { "type": "string", "description": "Where the user starts — the surface they land on, e.g. 'dashboard (after sign-in)'. Clicks are counted from here." }
+        }
+      }
+    },
+    "constraints": {
+      "type": "array",
+      "items": { "type": "string" },
+      "description": "Explicit constraints from the ticket (platform, deadline-driven scope cuts, must-integrate-with-X, etc.)."
+    },
+    "linkedDesigns": {
+      "type": "array",
+      "items": { "type": "string" },
+      "description": "URLs/references to existing designs mentioned in the ticket (Figma links, prior screens) that this should be visually consistent with."
+    },
+    "openQuestions": {
+      "type": "array",
+      "items": { "type": "string" },
+      "description": "Ambiguities the agent couldn't resolve from the ticket alone — surfaced to the human before generation starts rather than silently assumed."
+    }
+  }
+}
diff --git a/.claude/design-agent/schemas/user-flow.schema.json b/.claude/design-agent/schemas/user-flow.schema.json
new file mode 100644
index 0000000..a680be6
--- /dev/null
+++ b/.claude/design-agent/schemas/user-flow.schema.json
@@ -0,0 +1,145 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "$id": "https://example.com/schemas/user-flow.schema.json",
+  "title": "User Flow",
+  "description": "How a design's core tasks actually flow, and how the design plugs into the product: where users enter from, every step and decision, the error/cancel/empty paths, the way back, where they go next, and what existing pages must change to connect to it. Produced in generation Step 2c, before any screen is laid out. Checked by tools/flow_check.py and rubric category 10.",
+  "type": "object",
+  "required": ["id", "projectId", "briefRef", "screens", "entryPoints", "flows", "integrationChanges"],
+  "properties": {
+    "id": { "type": "string", "description": "e.g. 'DES-530-flow-1'." },
+    "projectId": { "type": "string" },
+    "briefRef": { "type": "string" },
+    "generatedAt": { "type": "string", "format": "date-time" },
+    "assumptions": { "type": "array", "items": { "type": "string" }, "description": "Answers to brief questions the flow depends on. If one changes, the flow is revised." },
+
+    "screens": {
+      "type": "array",
+      "description": "Every screen or state the flows pass through: this design's, existing product pages, and system screens (sign-in, an email client, the OS share sheet).",
+      "items": {
+        "type": "object",
+        "required": ["id", "name", "kind"],
+        "properties": {
+          "id": { "type": "string", "description": "e.g. 'S1'." },
+          "name": { "type": "string" },
+          "kind": {
+            "type": "string",
+            "enum": ["new", "existing", "system", "external"],
+            "description": "'new' = designed in this project. 'existing' = a product page owned by a design in the index. 'system' = a platform screen nobody designs here (sign-in, OS dialogs). 'external' = outside the product (an email, a notification)."
+          },
+          "surface": { "type": "string", "description": "Design-index surface name, e.g. 'settings/notifications'. Required for 'new' and 'existing'." },
+          "owningProject": { "type": "string", "description": "For 'existing': the design-index project that owns the surface." },
+          "route": { "type": "string", "description": "URL or deep link, e.g. '/settings/notifications?event={type}'." }
+        }
+      }
+    },
+
+    "entryPoints": {
+      "type": "array",
+      "description": "Every way into this design. Each one on an existing page needs an integration change for that page's design.",
+      "items": {
+        "type": "object",
+        "required": ["id", "from", "to", "trigger"],
+        "properties": {
+          "id": { "type": "string", "description": "e.g. 'E1'." },
+          "from": { "type": "string", "description": "A screen id." },
+          "to": { "type": "string", "description": "A screen id in this design." },
+          "trigger": { "type": "string", "description": "What the user taps or follows, e.g. \"'Manage notifications' link in the email footer\"." },
+          "carriesState": { "type": "string", "description": "What the link passes along, e.g. 'the event type, so it's highlighted on arrival'." },
+          "whenSignedOut": { "type": "string", "description": "What happens if the user isn't signed in: must return them to where they were going." },
+          "typicalDevice": { "type": "string", "enum": ["phone", "desktop", "any"] }
+        }
+      }
+    },
+
+    "flows": {
+      "type": "array",
+      "description": "One per core task in the brief. The steps here are what the design output's taskPaths are counted from.",
+      "items": {
+        "type": "object",
+        "required": ["taskId", "entryPoint", "steps", "done", "alternatePaths"],
+        "properties": {
+          "taskId": { "type": "string" },
+          "entryPoint": { "type": "string", "description": "An entryPoints id." },
+          "steps": {
+            "type": "array",
+            "items": {
+              "type": "object",
+              "required": ["screen", "action", "isClick"],
+              "properties": {
+                "screen": { "type": "string" },
+                "action": { "type": "string" },
+                "isClick": { "type": "boolean" },
+                "async": { "type": "boolean", "description": "True if the step waits on the network or a computation; it then needs a loading state and an error path." },
+                "next": { "type": "string", "description": "Screen id the step leads to, if it changes screen." }
+              }
+            }
+          },
+          "done": { "type": "string", "description": "How the user knows the task is complete, and where they are then." },
+          "alternatePaths": {
+            "type": "array",
+            "description": "Error, cancel, empty, signed-out and 'no longer exists' paths. Every async step needs an error path.",
+            "items": {
+              "type": "object",
+              "required": ["kind", "when", "then"],
+              "properties": {
+                "kind": { "type": "string", "enum": ["error", "cancel", "empty", "signed-out", "not-found", "permission", "offline"] },
+                "when": { "type": "string" },
+                "then": { "type": "string" },
+                "to": { "type": "string", "description": "Screen id, if the path leaves the current screen (e.g. sign-in)." }
+              }
+            }
+          }
+        }
+      }
+    },
+
+    "backNavigation": {
+      "type": "array",
+      "description": "The way back from every 'new' screen, including when it was reached by a deep link with no history.",
+      "items": {
+        "type": "object",
+        "required": ["screen", "back"],
+        "properties": {
+          "screen": { "type": "string" },
+          "back": { "type": "string", "description": "e.g. \"Breadcrumb 'Settings' → S2 (always, including from a deep link)\"." },
+          "to": { "type": "string", "description": "Screen id it goes to." }
+        }
+      }
+    },
+
+    "exits": {
+      "type": "array",
+      "description": "Where users go next once they're done.",
+      "items": {
+        "type": "object",
+        "required": ["from", "to", "when"],
+        "properties": {
+          "from": { "type": "string" },
+          "to": { "type": "string" },
+          "when": { "type": "string" }
+        }
+      }
+    },
+
+    "integrationChanges": {
+      "type": "array",
+      "description": "What must change outside this design for it to connect: a link, an entry point, a deep link. A change to another design's page is a revision of that design, owned by it, never a silent edit.",
+      "items": {
+        "type": "object",
+        "required": ["id", "screen", "change", "owner", "status"],
+        "properties": {
+          "id": { "type": "string", "description": "e.g. 'IC1'." },
+          "screen": { "type": "string" },
+          "change": { "type": "string" },
+          "owner": { "type": "string", "description": "The owning design-index project, or who owns a non-designed surface (e.g. 'email templates — engineering')." },
+          "kind": { "type": "string", "enum": ["new-entry-point", "changed-entry-point", "deep-link", "redirect", "removed-link"] },
+          "status": {
+            "type": "string",
+            "enum": ["proposed", "accepted", "rejected", "done"],
+            "description": "'proposed' until the owner accepts it. The design can't ship with an entry point whose change is rejected or still proposed."
+          }
+        }
+      }
+    }
+  }
+}
