@@ -0,0 +1,101 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "$id": "https://example.com/schemas/brief-optimization-report.schema.json",
+  "title": "Brief Optimization Report",
+  "description": "What skills/design-agent/reference/brief-optimization.md changed when turning a page brief, PRD or ticket into a design-ready ticket brief, and why. Shown to the author before generation; nothing in the optimized brief is hidden from them.",
+  "type": "object",
+  "required": ["id", "sourceRef", "briefRef", "manifestVersion", "generatedAt", "changes", "conflicts", "readiness"],
+  "properties": {
+    "id": { "type": "string", "description": "e.g. 'DES-530-brief-1'." },
+    "sourceRef": { "type": "string", "description": "The author's document (path or link). Never modified." },
+    "briefRef": { "type": "string", "description": "ticketKey of the optimized ticket brief." },
+    "manifestVersion": { "type": "string" },
+    "generatedAt": { "type": "string", "format": "date-time" },
+    "lint": {
+      "type": "object",
+      "description": "tools/brief_lint.py's result, if it ran.",
+      "properties": {
+        "result": { "type": "string", "enum": ["ready", "needs-work", "not-ready"] },
+        "findings": { "type": "array", "items": { "type": "string" } }
+      }
+    },
+    "changes": {
+      "type": "array",
+      "description": "Every rewrite, from the author's wording to the optimized wording.",
+      "items": {
+        "type": "object",
+        "required": ["kind", "original", "optimized", "reason"],
+        "properties": {
+          "kind": {
+            "type": "string",
+            "enum": ["vague-term", "solution-to-need", "testable-criterion", "added-state", "added-volume", "ranked-goal", "component-hint", "inferred", "edge-case"],
+            "description": "Which optimization rule produced it (skills/design-agent/reference/brief-optimization.md, 'Fit it to the design system')."
+          },
+          "section": { "type": "string", "description": "Section of the source it came from." },
+          "original": { "type": "string" },
+          "optimized": { "type": "string" },
+          "reason": { "type": "string", "description": "The rule, token or threshold behind it, e.g. 'vocabulary map: pop → hierarchy; color.usagePolicy.maxPrimaryActionsPerScreen'." },
+          "confirmed": { "type": "boolean", "description": "Set once the author accepts it. Inferred items must be confirmed before the brief is ready." }
+        }
+      }
+    },
+    "conflicts": {
+      "type": "array",
+      "description": "Requests that break a design-system rule. Never resolved silently.",
+      "items": {
+        "type": "object",
+        "required": ["request", "rule", "proposedResolution"],
+        "properties": {
+          "request": { "type": "string" },
+          "rule": { "type": "string", "description": "The manifest field or principle it conflicts with." },
+          "proposedResolution": { "type": "string" },
+          "accepted": { "type": "boolean" }
+        }
+      }
+    },
+    "componentHints": {
+      "type": "array",
+      "description": "Approved components that likely cover each required element: input to the reuse check (Step 3), not a decision.",
+      "items": {
+        "type": "object",
+        "required": ["element", "candidates"],
+        "properties": {
+          "element": { "type": "string" },
+          "candidates": { "type": "array", "items": { "type": "string" } }
+        }
+      }
+    },
+    "edgeCaseSweep": {
+      "type": "object",
+      "description": "Result of skills/design-agent/reference/edge-case-sweep.md: tools/edge_case_check.py's verdict and the counts by disposition.",
+      "properties": {
+        "result": { "type": "string", "enum": ["complete", "needs-answers", "incomplete"] },
+        "entities": { "type": "integer" },
+        "cases": { "type": "integer" },
+        "byDisposition": { "type": "object", "additionalProperties": { "type": "integer" } }
+      }
+    },
+    "newBriefs": {
+      "type": "array",
+      "description": "Separate briefs the sweep found are needed: parts of the product this page depends on that no design covers. Each is opened as its own page brief; the scope check links them.",
+      "items": {
+        "type": "object",
+        "required": ["title", "why"],
+        "properties": {
+          "title": { "type": "string" },
+          "why": { "type": "string" },
+          "fromEdgeCases": { "type": "array", "items": { "type": "string" }, "description": "Edge-case and entity-operation references that produced it." },
+          "blocksThisDesign": { "type": "boolean", "description": "True if this design can't ship without it (e.g. nothing to vote on without the admin side)." }
+        }
+      }
+    },
+    "relatedDesigns": { "type": "array", "items": { "type": "string" }, "description": "Design-index projects the brief's terms or surfaces touch; the scope check (Step 2b) decides." },
+    "openQuestions": { "type": "array", "items": { "type": "string" } },
+    "readiness": {
+      "type": "string",
+      "enum": ["ready", "needs-answers", "not-ready"],
+      "description": "'ready' only when no questions are open, every conflict is accepted, and every inferred change is confirmed."
+    },
+    "approvedBy": { "type": "string", "description": "Who approved the optimized brief, when briefPolicy.approvalBeforeGeneration is true." }
+  }
+}
diff --git a/.claude/design-agent/schemas/component-gap-report.schema.json b/.claude/design-agent/schemas/component-gap-report.schema.json
new file mode 100644
index 0000000..73146dc
--- /dev/null
+++ b/.claude/design-agent/schemas/component-gap-report.schema.json
@@ -0,0 +1,42 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "$id": "https://example.com/schemas/component-gap-report.schema.json",
+  "title": "Component Gap Report",
+  "description": "Emitted by the design agent whenever a ticket needs a component or variant the manifest doesn't have (or only has as 'proposed'). A human reviews this report; approved items get promoted into the manifest's components[] registry with status: approved, so later tickets reuse them instead of regenerating near-duplicates.",
+  "type": "object",
+  "required": ["ticket", "manifestVersion", "gaps"],
+  "properties": {
+    "ticket": { "type": "string", "description": "Source Jira ticket key, e.g. 'DES-512'." },
+    "manifestVersion": { "type": "string", "description": "meta.version of the manifest this report was generated against." },
+    "generatedAt": { "type": "string", "format": "date-time" },
+    "gaps": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": ["id", "gapType", "targetCategory", "suggestedName", "rationale", "recommendation"],
+        "properties": {
+          "id": { "type": "string", "description": "Stable ID for this gap entry, e.g. 'DES-512-gap-1'. Referenced by design-output (componentsUsed[].gapReportId, gapReportsFiled), audit-report findings (relatedGapReportId), and component-verification-report (gapReportId)." },
+          "gapType": {
+            "type": "string",
+            "enum": ["missing-component", "missing-variant"],
+            "description": "missing-component: no existing entry fits this category/purpose at all. missing-variant: the base component exists (e.g. Button) but not in the needed flavor (e.g. 'icon-only')."
+          },
+          "targetCategory": {
+            "type": "string",
+            "enum": ["action", "input", "display", "feedback", "navigation", "layout", "overlay", "data-viz"]
+          },
+          "existingComponent": { "type": "string", "description": "For missing-variant gaps: the component this would extend, e.g. 'Button'." },
+          "suggestedName": { "type": "string", "description": "Proposed name for the new component or variant, e.g. 'StatTile' or 'icon-only'." },
+          "rationale": { "type": "string", "description": "Why the ticket needs this and why nothing approved already covers it." },
+          "suggestedProps": { "type": "array", "items": { "type": "string" } },
+          "recommendation": {
+            "type": "string",
+            "enum": ["create-new", "reuse-nearest-approved", "extend-existing-variant"],
+            "description": "The agent's suggestion. 'reuse-nearest-approved' means the gap is real but the agent thinks an approved component can be adapted instead of adding a new one — use this to push back on registry sprawl."
+          },
+          "nearestApprovedAlternative": { "type": "string", "description": "Set when recommendation is reuse-nearest-approved — names the existing component/variant to use instead." }
+        }
+      }
+    }
+  }
+}
diff --git a/.claude/design-agent/schemas/component-verification-report.schema.json b/.claude/design-agent/schemas/component-verification-report.schema.json
new file mode 100644
index 0000000..37d3734
--- /dev/null
+++ b/.claude/design-agent/schemas/component-verification-report.schema.json
@@ -0,0 +1,155 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "$id": "https://example.com/schemas/component-verification-report.schema.json",
+  "title": "Component Verification Report",
+  "description": "Required before a proposed component or variant (from a component-gap-report) can flip status to 'approved' in the manifest's components[] registry. Two jobs: (1) confirm it's actually operational, not just visually plausible — every state implemented, accessible, responsive; (2) explain why it was built this way, so a reviewer isn't approving a black box.",
+  "type": "object",
+  "required": ["id", "componentName", "gapReportId", "operationalSpec", "dynamicBehavior", "designRationale", "verification", "verdict"],
+  "properties": {
+    "id": { "type": "string", "description": "Stable ID for this report, e.g. 'DES-512-gap-1-verify'. Referenced by design-output.verificationReportsFiled." },
+    "componentName": { "type": "string" },
+    "variantName": { "type": "string", "description": "Set if this verifies a variant of an existing component rather than a whole new component." },
+    "gapReportId": { "type": "string", "description": "The component-gap-report entry this verifies." },
+    "reviewedAt": { "type": "string", "format": "date-time" },
+
+    "operationalSpec": {
+      "type": "object",
+      "description": "What this component actually does — the contract a build agent or future designer can rely on without re-deriving it from the mockup.",
+      "required": ["states", "props"],
+      "properties": {
+        "purpose": { "type": "string", "description": "One line: what this component is for and when to reach for it." },
+        "states": {
+          "type": "array",
+          "description": "Every interaction/data state this component must handle, not just the one shown in the mockup.",
+          "items": {
+            "type": "object",
+            "required": ["name", "description", "implemented"],
+            "if": { "properties": { "notApplicable": { "const": true } }, "required": ["notApplicable"] },
+            "then": { "required": ["notApplicableReason"] },
+            "properties": {
+              "name": { "type": "string", "enum": ["default", "hover", "focus", "active", "disabled", "loading", "error", "empty", "success"] },
+              "description": { "type": "string", "description": "What changes in this state and why." },
+              "implemented": { "type": "boolean", "description": "Whether this state actually exists in the artifact, not just in the spec." },
+              "notApplicable": { "type": "boolean", "default": false, "description": "True when this state deliberately does not apply to the component (e.g. focus on a non-interactive display). Requires notApplicableReason. Excluded from verification.allStatesImplemented." },
+              "notApplicableReason": { "type": "string", "description": "Required when notApplicable is true: why the state doesn't apply, citing the ticket, a principle, or whenNotToUse." }
+            }
+          }
+        },
+        "props": {
+          "type": "array",
+          "items": {
+            "type": "object",
+            "required": ["name", "type"],
+            "properties": {
+              "name": { "type": "string" },
+              "type": { "type": "string" },
+              "required": { "type": "boolean", "default": false },
+              "description": { "type": "string" }
+            }
+          }
+        },
+        "responsiveBehavior": {
+          "type": "array",
+          "description": "What this component does at each layout.breakpoints step — required if it's used anywhere near a breakpoint boundary.",
+          "items": {
+            "type": "object",
+            "properties": {
+              "breakpoint": { "type": "string", "description": "e.g. 'sm', 'md', or a raw px value." },
+              "behavior": { "type": "string" }
+            }
+          }
+        },
+        "whenNotToUse": { "type": "string", "description": "Explicit boundary — prevents the component being reached for outside its intended purpose later." }
+      }
+    },
+
+    "dynamicBehavior": {
+      "type": "object",
+      "description": "How the component adapts, per the dynamic-components rules in design-principles.md. No component is approved without it: this is what makes every component work on mobile and everywhere else.",
+      "required": ["sizing", "containerAdaptation", "contentHandling", "textScaling", "inputModes"],
+      "properties": {
+        "sizing": { "type": "string", "description": "How it sizes: e.g. 'fills its container; min 160px, max 320px wide; height from content'. Fixed sizes only for icons/targets up to mobile.maxFixedSizePx." },
+        "containerAdaptation": {
+          "type": "array",
+          "description": "What it does at each container width it can be placed in, narrowest first.",
+          "items": {
+            "type": "object",
+            "required": ["containerWidth", "behavior"],
+            "properties": {
+              "containerWidth": { "type": "string", "description": "e.g. '< 240px', '240–480px', '> 480px'." },
+              "behavior": { "type": "string" }
+            }
+          }
+        },
+        "contentHandling": {
+          "type": "object",
+          "required": ["short", "long", "empty"],
+          "properties": {
+            "short": { "type": "string" },
+            "long": { "type": "string", "description": "Including translated text up to mobile.textExpansionPercent longer, and long unbroken words." },
+            "empty": { "type": "string" },
+            "overflow": { "type": "string", "description": "How truncated content stays reachable in full." }
+          }
+        },
+        "textScaling": {
+          "type": "object",
+          "required": ["testedAtPercent", "result"],
+          "properties": {
+            "testedAtPercent": { "type": "integer", "description": "Should be at least mobile.maxTextScalePercent." },
+            "result": { "type": "string", "description": "What changes, and confirmation nothing clips or overlaps." }
+          }
+        },
+        "inputModes": {
+          "type": "object",
+          "required": ["touch", "pointer", "keyboard"],
+          "properties": {
+            "touch": { "type": "string" },
+            "pointer": { "type": "string" },
+            "keyboard": { "type": "string" }
+          }
+        },
+        "orientationAndSafeArea": { "type": "string", "description": "Landscape behavior, and safe-area/keyboard handling if it sits near a screen edge." },
+        "dataDriven": { "type": "string", "description": "Confirms content comes in through props, with nothing hard-coded." }
+      }
+    },
+
+    "designRationale": {
+      "type": "array",
+      "description": "Why this component looks and behaves the way it does — one entry per notable structural decision. Every entry must cite a principle, token, or manifest field, not a preference (same bar as implementationNote in audit-report.schema.json).",
+      "items": {
+        "type": "object",
+        "required": ["decision", "reasoning"],
+        "properties": {
+          "decision": { "type": "string", "description": "e.g. 'Trend indicator uses an arrow icon + color, not color alone.'" },
+          "reasoning": { "type": "string", "description": "e.g. 'accessibility.requireSemanticHtml and rubric category 2 — color can't be the only signal for state.'" },
+          "principleOrTokenRef": { "type": "string", "description": "e.g. 'design-principles.md: Consistency Is Non-Negotiable' or 'color.accents.success'." }
+        }
+      }
+    },
+
+    "verification": {
+      "type": "object",
+      "description": "The operational-readiness checklist — did it actually get built out, not just described.",
+      "required": ["allStatesImplemented", "accessibilityPass", "tokenCompliant", "dynamicPass", "checkedBy"],
+      "properties": {
+        "allStatesImplemented": { "type": "boolean", "description": "False if any state in operationalSpec.states that is not marked notApplicable has implemented: false. States marked notApplicable (with a reason) do not count against this." },
+        "accessibilityPass": { "type": "boolean", "description": "Meets accessibility.level from the manifest — contrast, touch target, focus visibility, semantics." },
+        "dynamicPass": { "type": "boolean", "description": "Works at the narrowest container and at mobile.minViewportPx, survives maxTextScalePercent and textExpansionPercent, handles empty content, and works by touch alone." },
+        "tokenCompliant": { "type": "boolean", "description": "Uses only manifest tokens — no hardcoded values (design-principles.md: Consistency Is Non-Negotiable)." },
+        "notes": { "type": "string" },
+        "checkedBy": {
+          "type": "string",
+          "enum": ["human-designer", "agent-self-check-pending-human", "human-designer-via-agent-checklist"],
+          "description": "'agent-self-check-pending-human' means the agent ran the checklist but a human hasn't confirmed it yet — cannot alone justify an 'approved' status if registryPolicy.verificationReviewer requires human sign-off."
+        }
+      }
+    },
+
+    "verdict": {
+      "type": "string",
+      "enum": ["ready-for-implementation", "needs-revision"],
+      "description": "'ready-for-implementation' is what allows the linked component-gap-report's status to flip from 'proposed' to 'approved' in the manifest — this is the actual approval gate, not the gap report by itself."
+    },
+    "revisionNotes": { "type": "string", "description": "Required if verdict is needs-revision — specific, not general." }
+  }
+}
diff --git a/.claude/design-agent/schemas/design-index.schema.json b/.claude/design-agent/schemas/design-index.schema.json
new file mode 100644
index 0000000..464351c
--- /dev/null
+++ b/.claude/design-agent/schemas/design-index.schema.json
@@ -0,0 +1,136 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "$id": "https://example.com/schemas/design-index.schema.json",
+  "title": "Design Index",
+  "description": "The living map of every design project and the artifacts that belong to it (PRDs, ticket briefs, design outputs, gap/verification/audit reports). Two jobs: (1) scope placement — before a new brief becomes a new design, it is compared against every project here to catch work that really belongs to an existing design (see scope-overlap-report.schema.json); (2) change propagation — artifacts declare what they depend on, so when one changes, everything downstream is flagged for review instead of silently drifting.",
+  "type": "object",
+  "required": ["projects"],
+  "properties": {
+    "updatedAt": { "type": "string", "format": "date-time" },
+    "navigation": {
+      "type": "object",
+      "description": "The product's navigation map: every link between surfaces, so a new design can see how it connects and what already links where. Updated in generation Step 12 from each design's user flow.",
+      "properties": {
+        "links": {
+          "type": "array",
+          "items": {
+            "type": "object",
+            "required": ["from", "to", "label", "kind"],
+            "properties": {
+              "from": { "type": "string", "description": "A surface, or an external source like 'email'." },
+              "to": { "type": "string", "description": "A surface." },
+              "label": { "type": "string", "description": "What the user sees or taps." },
+              "kind": { "type": "string", "enum": ["nav", "deep-link", "redirect", "back"] },
+              "projectId": { "type": "string", "description": "The design that added the link." },
+              "status": { "type": "string", "enum": ["proposed", "live"], "default": "live" }
+            }
+          }
+        }
+      }
+    },
+    "projects": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": ["id", "title", "status", "scopeSummary", "scopeTerms", "surfaces", "artifacts"],
+        "properties": {
+          "id": { "type": "string", "description": "Stable project ID — usually the originating ticket or PRD key, e.g. 'DES-512'." },
+          "title": { "type": "string" },
+          "status": {
+            "type": "string",
+            "enum": ["in-progress", "approved", "shipped", "deprecated"],
+            "description": "Extending an 'approved' or 'shipped' project means a new revision of it, not a silent edit. 'deprecated' projects are still compared against (to catch reintroducing retired work) but are never recommended as a merge target."
+          },
+          "scopeSummary": { "type": "string", "description": "One or two sentences: what problem this design owns." },
+          "scopeTerms": {
+            "type": "array",
+            "items": { "type": "string" },
+            "description": "Normalized domain terms this project owns, lowercase, singular — e.g. ['kpi', 'trend', 'date-range filter']. Compared by Jaccard overlap in the scope check, so keep them specific; generic words ('page', 'user', 'button') dilute the signal."
+          },
+          "surfaces": {
+            "type": "array",
+            "items": { "type": "string" },
+            "description": "Screens/areas of the product this project changes, e.g. ['dashboard', 'dashboard/toolbar']. Two projects editing the same surface is the strongest sign of overlap."
+          },
+          "codePaths": {
+            "type": "array",
+            "items": { "type": "string" },
+            "description": "Globs for the code that implements this design, e.g. 'src/app/dashboard/**'. This is how design context reaches development: when someone edits a file under these paths, tools/design_context.py shows this project's decisions, components and open review flags. Required once status is approved or shipped."
+          },
+          "priorities": {
+            "type": "array",
+            "description": "Copied from the project's ticket brief so new briefs can be compared priority-by-priority.",
+            "items": {
+              "type": "object",
+              "required": ["id", "statement"],
+              "properties": {
+                "id": { "type": "string" },
+                "statement": { "type": "string" }
+              }
+            }
+          },
+          "componentsUsed": {
+            "type": "array",
+            "items": { "type": "string" },
+            "description": "Component/variant names this project uses, e.g. 'Button/icon-only'. Lets a related project reuse the same pieces rather than re-deciding them."
+          },
+          "relatedProjects": {
+            "type": "array",
+            "description": "Explicit cross-project relationships, recorded when a scope check routes work between projects.",
+            "items": {
+              "type": "object",
+              "required": ["projectId", "relation"],
+              "properties": {
+                "projectId": { "type": "string" },
+                "relation": {
+                  "type": "string",
+                  "enum": ["extends", "extended-by", "shares-pattern", "supersedes", "superseded-by", "links-to", "linked-from"],
+                  "description": "'shares-pattern' = separate projects that must stay consistent on a shared interaction (e.g. the same date-range filter). 'links-to' / 'linked-from' = one design is an entry point into the other, so a change to either can break the flow."
+                },
+                "note": { "type": "string" },
+                "scopeOverlapReportId": { "type": "string" }
+              }
+            }
+          },
+          "artifacts": {
+            "type": "array",
+            "description": "Every artifact belonging to this project, with its dependencies. This is the integration graph.",
+            "items": {
+              "type": "object",
+              "required": ["id", "type", "version", "reviewStatus"],
+              "properties": {
+                "id": { "type": "string", "description": "The artifact's own ID, e.g. 'DES-512-gap-1' or 'audit-report-DES-512-rev1'." },
+                "type": {
+                  "type": "string",
+                  "enum": ["prd", "page-brief", "ticket-brief", "brief-optimization-report", "scope-overlap-report", "user-flow", "design-output", "component-gap-report", "component-verification-report", "audit-report", "implementation-review", "screenshot-set"],
+                  "description": "'implementation-review' = an audit-report with mode: implementation, auditing the built UI against the design (harness stage 'verify')."
+                },
+                "path": { "type": "string", "description": "File path or URL." },
+                "version": { "type": "integer", "minimum": 1, "description": "Bump on every change. A dependent's dependsOn[].version records which version it was built against." },
+                "dependsOn": {
+                  "type": "array",
+                  "items": {
+                    "type": "object",
+                    "required": ["artifactId", "version"],
+                    "properties": {
+                      "artifactId": { "type": "string" },
+                      "version": { "type": "integer", "description": "The upstream version this artifact was built from. If the upstream's current version is higher, this artifact is stale." }
+                    }
+                  }
+                },
+                "reviewStatus": {
+                  "type": "string",
+                  "enum": ["current", "needs-review"],
+                  "description": "'needs-review' = an upstream artifact changed after this one was built. Set automatically on propagation; only a human or a fresh re-run clears it."
+                },
+                "reviewReason": { "type": "string", "description": "Required when needs-review: which upstream changed and what changed in it." }
+              },
+              "if": { "properties": { "reviewStatus": { "const": "needs-review" } } },
+              "then": { "required": ["reviewReason"] }
+            }
+          }
+        }
+      }
+    }
+  }
+}
diff --git a/.claude/design-agent/schemas/design-output.schema.json b/.claude/design-agent/schemas/design-output.schema.json
new file mode 100644
index 0000000..4e9b6ac
--- /dev/null
+++ b/.claude/design-agent/schemas/design-output.schema.json
@@ -0,0 +1,199 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "$id": "https://example.com/schemas/design-output.schema.json",
+  "title": "Design Output",
+  "description": "What design-generation-skill.md produces for one ticket. This is what gets audited (design-audit-rubric.md / audit-report.schema.json) and, on approval, what a human reviews.",
+  "type": "object",
+  "required": ["ticket", "projectId", "manifestVersion", "artifact", "componentsUsed", "decisionLog"],
+  "anyOf": [{ "required": ["screenshotSetRef"] }, { "required": ["mobileCheck"] }],
+  "properties": {
+    "ticket": { "type": "string" },
+    "projectId": { "type": "string", "description": "design-index project this output belongs to. Equals ticket for a new project; for an 'extend-existing' scope outcome it is the existing project's ID." },
+    "screenshotSetRef": { "type": "string", "description": "When the design is a renderable page: the screenshot set (tools/screenshots.py) that backs mobileCheck." },
+    "userFlowRef": { "type": "string", "description": "The user-flow (Step 2c) this design implements. Its taskPaths are counted from that flow's steps." },
+    "scopeOverlapReportRef": { "type": "string", "description": "The scope-overlap-report that placed this work. Required whenever scopePolicy.requireScopeCheck is true." },
+    "manifestVersion": { "type": "string" },
+    "generatedAt": { "type": "string", "format": "date-time" },
+    "revisionNumber": { "type": "integer", "default": 0, "description": "0 = first draft. Increments on each auto-revise loop triggered by a major-issues audit verdict." },
+
+    "artifact": {
+      "type": "object",
+      "description": "The actual design deliverable.",
+      "required": ["format", "location"],
+      "properties": {
+        "format": { "type": "string", "enum": ["html", "react-jsx", "figma-spec", "markdown-wireframe", "claude-design-canvas"], "description": "Matches meta.framework/stylingEngine where applicable. 'claude-design-canvas' = a Design canvas on claude.ai." },
+        "location": { "type": "string", "description": "File path, or URL (for a Claude Design canvas, its claude.ai link)." },
+        "designSystemRef": { "type": "string", "description": "For claude-design-canvas: the Design System artifact the canvas installed. Must be the one exported from this manifest version." },
+        "boards": {
+          "type": "array",
+          "description": "For claude-design-canvas: one artboard per screen × breakpoint shown.",
+          "items": {
+            "type": "object",
+            "required": ["file", "breakpoint"],
+            "properties": {
+              "file": { "type": "string", "description": "e.g. 'Dashboard-sm.dc.html'." },
+              "screen": { "type": "string" },
+              "breakpoint": { "type": "string", "description": "A layout.breakpoints key, e.g. 'sm'." },
+              "interactive": { "type": "boolean", "description": "True when the board is a clickable prototype (used for the 3-3-3 task paths)." }
+            }
+          }
+        }
+      }
+    },
+
+    "mobileCheck": {
+      "type": "object",
+      "description": "The mobile pass (generation Step 9b), required on every design. Each item is a claim the critic verifies against the artifact.",
+      "required": ["minViewportPx", "designedAtPhoneFirst", "reflowsWithoutHorizontalScroll", "textScaleTested", "noHoverOnlyInteractions", "touchTargetsAndSpacing", "primaryActionInThumbZone", "safeAreasAndKeyboard", "orientations"],
+      "properties": {
+        "minViewportPx": { "type": "integer" },
+        "designedAtPhoneFirst": { "type": "boolean", "description": "The phone layout exists and was designed first." },
+        "reflowsWithoutHorizontalScroll": { "type": "boolean" },
+        "textScaleTested": { "type": "object", "required": ["percent", "pass"], "properties": { "percent": { "type": "integer" }, "pass": { "type": "boolean" }, "notes": { "type": "string" } } },
+        "noHoverOnlyInteractions": { "type": "boolean" },
+        "touchTargetsAndSpacing": { "type": "boolean" },
+        "primaryActionInThumbZone": { "type": "boolean" },
+        "thumbZoneReason": { "type": "string", "description": "Required when primaryActionInThumbZone is false." },
+        "safeAreasAndKeyboard": { "type": "boolean", "description": "Safe areas respected; the on-screen keyboard never covers the focused field." },
+        "orientations": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Behavior per orientation, e.g. {portrait: '...', landscape: '...'}." },
+        "notes": { "type": "string" }
+      }
+    },
+
+    "acceptanceResults": {
+      "type": "array",
+      "description": "One entry per acceptanceCriteria item in the brief: met or not, with evidence the critic can check.",
+      "items": {
+        "type": "object",
+        "required": ["criterionId", "met", "evidence"],
+        "properties": {
+          "criterionId": { "type": "string" },
+          "met": { "type": "boolean" },
+          "evidence": { "type": "string", "description": "Where in the design it's met: a board, a task path, a state." }
+        }
+      }
+    },
+
+    "glanceTest": {
+      "type": "array",
+      "description": "3-3-3 rule, part 1: per screen, what a first-time user sees first at usabilityHeuristics.threeThreeThree.glanceBreakpoint, without scrolling.",
+      "items": {
+        "type": "object",
+        "required": ["screen", "breakpoint", "purposeVisible", "primaryActionVisible", "pass"],
+        "properties": {
+          "screen": { "type": "string" },
+          "breakpoint": { "type": "string" },
+          "firstNoticed": { "type": "array", "items": { "type": "string" }, "description": "The first two or three things the eye lands on, in order." },
+          "purposeVisible": { "type": "boolean", "description": "Is what this screen is for clear from what's visible, without reading body text?" },
+          "primaryActionVisible": { "type": "boolean", "description": "Is the one primary action visible and identifiable without scrolling?" },
+          "pass": { "type": "boolean" },
+          "notes": { "type": "string" }
+        }
+      }
+    },
+
+    "taskPaths": {
+      "type": "array",
+      "description": "3-3-3 rule, parts 2 and 3: every coreTask from the brief, walked step by step from its entry point.",
+      "items": {
+        "type": "object",
+        "required": ["taskId", "steps", "clickCount", "estimatedSeconds", "estimateBasis"],
+        "properties": {
+          "taskId": { "type": "string", "description": "ticket-brief coreTasks[].id." },
+          "steps": {
+            "type": "array",
+            "items": {
+              "type": "object",
+              "required": ["action", "isClick"],
+              "properties": {
+                "action": { "type": "string", "description": "e.g. 'Tap the 30d preset chip'." },
+                "isClick": { "type": "boolean", "description": "False for typing, reading, or waiting." },
+                "scent": { "type": "string", "description": "What tells the user this is the right step — the label, icon, or placement. Required when clickCount exceeds maxClicksToCoreTask." }
+              }
+            }
+          },
+          "clickCount": { "type": "integer", "minimum": 0 },
+          "estimatedSeconds": { "type": "number", "minimum": 0, "description": "Estimated time for a first-time user, including reading and waiting." },
+          "estimateBasis": { "type": "string", "description": "How the estimate was made — the assumptions, e.g. '~3 s to scan, 1 tap, ~2 s for results to load'." },
+          "overLimitReason": { "type": "string", "description": "Required if clickCount or estimatedSeconds exceeds the manifest limits." }
+        }
+      }
+    },
+
+    "componentsUsed": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": ["name", "variant", "status"],
+        "properties": {
+          "name": { "type": "string" },
+          "variant": { "type": "string" },
+          "status": { "type": "string", "enum": ["approved", "proposed"] },
+          "gapReportId": { "type": "string", "description": "Set if status is 'proposed' — links back to the gap report that justified using it." }
+        }
+      }
+    },
+
+    "gapReportsFiled": {
+      "type": "array",
+      "items": { "type": "string" },
+      "description": "IDs/paths of component-gap-report entries generated during this draft."
+    },
+
+    "verificationReportsFiled": {
+      "type": "array",
+      "items": { "type": "string" },
+      "description": "IDs/paths of component-verification-report entries generated for any new component/variant used — required alongside gapReportsFiled when registryPolicy.requireOperationalVerification is true. A component used here with status: proposed and no corresponding verification report is a reuse-and-component-discipline blocker in the audit."
+    },
+
+    "decisionLog": {
+      "type": "array",
+      "description": "Every Decision Protocol invocation during generation, regardless of decisionProtocol mode — logged even under auto-apply for auditability. Decisions inherited from a related project (scope-overlap-report.reusedDecisions) are logged here too, with mode 'inherited'.",
+      "items": {
+        "type": "object",
+        "required": ["decision", "alternativesConsidered", "chosen", "mode"],
+        "properties": {
+          "decision": { "type": "string", "description": "What was being decided, e.g. 'information architecture for KPI summary'." },
+          "alternativesConsidered": {
+            "type": "array",
+            "items": {
+              "type": "object",
+              "required": ["option", "tradeoff"],
+              "properties": {
+                "option": { "type": "string" },
+                "tradeoff": { "type": "string", "description": "What this option prioritizes and what it costs." }
+              }
+            }
+          },
+          "chosen": { "type": "string" },
+          "rationale": { "type": "string" },
+          "mode": { "type": "string", "enum": ["human-approved", "auto-applied", "inherited"], "description": "Whether a human picked this, the agent proceeded per ask-major-only/auto-apply, or it was reused from a related project's approved decision (set inheritedFrom)." },
+          "inheritedFrom": { "type": "string", "description": "When mode is inherited: the design-index project ID the decision came from." },
+          "linkedPriority": { "type": "string", "description": "ticket-brief priority id this decision serves." }
+        }
+      }
+    },
+
+    "openQuestionsRemaining": {
+      "type": "array",
+      "items": { "type": "string" },
+      "description": "Anything still unresolved and explicitly deferred rather than guessed at."
+    },
+
+    "signOff": {
+      "type": "object",
+      "description": "The human approval that passes the harness 'approval' gate: only after a pass/minor-issues audit, with every proposed component verified and every integration change accepted.",
+      "required": ["by", "at"],
+      "properties": {
+        "by": { "type": "string" },
+        "at": { "type": "string", "format": "date-time" },
+        "note": { "type": "string" }
+      }
+    },
+
+    "auditReportRef": {
+      "type": "string",
+      "description": "Populated once the automatic audit handoff (Step 11) runs — path/ID of the resulting audit-report."
+    }
+  }
+}
diff --git a/.claude/design-agent/schemas/design-system-manifest.schema.json b/.claude/design-agent/schemas/design-system-manifest.schema.json
new file mode 100644
index 0000000..975affb
--- /dev/null
+++ b/.claude/design-agent/schemas/design-system-manifest.schema.json
@@ -0,0 +1,689 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "$id": "https://example.com/schemas/design-system-manifest.schema.json",
+  "title": "Design System Manifest",
+  "description": "Project-specific design system data consumed by a generalized design-principles agent skill. Fixed reasoning rules (decision protocol, contrast math, animation physics) stay in the skill itself; this file supplies the 'what exists / what's allowed' data per project.",
+  "type": "object",
+  "required": ["meta", "color", "typography", "spacing", "layout", "components", "accessibility"],
+  "if": {
+    "properties": { "platform": { "properties": { "targets": { "contains": { "const": "claude-design" } } }, "required": ["targets"] } },
+    "required": ["platform"]
+  },
+  "then": {
+    "properties": { "color": { "required": ["resolved"] } }
+  },
+  "properties": {
+
+    "harness": {
+      "type": "object",
+      "description": "How much process each design gets. 'lite' (default): the core skill, tool checks, one critic pass with skills/design-agent/critic.md, one human stop per stage. 'full': the complete process in skills/design-agent/reference/design-generation-skill.md, with every record and the full rubric; use it for flagship work. See the README's 'Cost' section.",
+      "properties": {
+        "mode": { "type": "string", "enum": ["lite", "full"], "default": "lite" }
+      }
+    },
+
+    "platform": {
+      "type": "object",
+      "description": "Where this design system is used. The same manifest drives both: Claude Code (a repo with CLAUDE.md and files) and Claude Design (a Design System artifact plus Design canvases on claude.ai). See skills/design-agent/reference/platform-adapters.md.",
+      "properties": {
+        "targets": {
+          "type": "array",
+          "items": { "type": "string", "enum": ["claude-code", "claude-design"] },
+          "minItems": 1,
+          "uniqueItems": true,
+          "default": ["claude-code"],
+          "description": "Including 'claude-design' requires color.resolved, because a Design System needs real color values, not framework class names."
+        },
+        "claudeDesign": {
+          "type": "object",
+          "properties": {
+            "designSystemUrl": { "type": "string", "description": "The claude.ai link of the Design System artifact exported from this manifest. Empty until the first export." },
+            "markAsDefault": { "type": "boolean", "default": true, "description": "Keep it as the account's default design system, so every new Design canvas applies it without being asked — the Claude Design equivalent of CLAUDE.md always loading." },
+            "recordStore": {
+              "type": "string",
+              "enum": ["repo", "design-system-section"],
+              "default": "repo",
+              "description": "Where briefs, scope/gap/verification/audit reports and the design index live. 'repo' = a connected repository (full pipeline). 'design-system-section' = the design index only, as a design-index.md section of the Design System; per-run reports are returned in the conversation, not stored, so scope checks and change tracking only see what the index records."
+            },
+            "canvasBoards": {
+              "type": "object",
+              "description": "Artboard sizes for Design canvases, one per breakpoint the design shows.",
+              "properties": {
+                "phone": { "type": "object", "properties": { "w": { "type": "integer", "default": 390 }, "h": { "type": "integer", "default": 844 } } },
+                "desktop": { "type": "object", "properties": { "w": { "type": "integer", "default": 1440 }, "h": { "type": "integer", "default": 900 } } }
+              }
+            }
+          }
+        }
+      }
+    },
+
+    "meta": {
+      "type": "object",
+      "description": "Identity and governance for this design system.",
+      "required": ["name", "version"],
+      "properties": {
+        "name": { "type": "string", "description": "Human-readable name of the design system, e.g. 'Acme Product UI'." },
+        "version": { "type": "string", "description": "Semver of this manifest, bump whenever tokens/components change." },
+        "framework": { "type": "string", "description": "e.g. 'react', 'vue', 'web-components', 'swiftui'. Informs how components are imported/rendered." },
+        "stylingEngine": { "type": "string", "description": "e.g. 'tailwind', 'css-modules', 'styled-components', 'css-variables'." },
+        "decisionProtocol": {
+          "type": "string",
+          "enum": ["always-ask", "ask-major-only", "auto-apply"],
+          "default": "always-ask",
+          "description": "Mirrors the bencium skill's 'CRITICAL: always ask before design decisions' rule. 'ask-major-only' lets the agent auto-decide low-stakes details (e.g. spacing within an approved scale) but still ask about color/type/layout direction."
+        },
+        "claudeMd": {
+          "type": "object",
+          "description": "The project's CLAUDE.md, which Claude Code loads into every session. It carries a summary of this manifest (tokens, brand rules, critique criteria) so even quick edits that don't run the design agent follow the design system. Built from templates/CLAUDE.md.",
+          "properties": {
+            "path": { "type": "string", "default": "CLAUDE.md", "description": "Where the file lives, relative to the repo root. Claude Code loads CLAUDE.md from the project root automatically." },
+            "required": { "type": "boolean", "default": true, "description": "If true, the design-generation skill halts when the file is missing or its version stamp doesn't match meta.version, and offers to regenerate it from this manifest." }
+          }
+        },
+        "brandExclusions": {
+          "type": "array",
+          "items": { "type": "string" },
+          "description": "Explicit anti-patterns for this project, e.g. ['#3B82F6 SaaS blue', 'glass morphism', 'drop shadows for depth']. Seeds the skill's 'Common Patterns to Avoid' check with project-specific bans."
+        }
+      }
+    },
+
+    "color": {
+      "type": "object",
+      "description": "Color roles, not raw swatches — mirrors the skill's base/accent palette architecture.",
+      "required": ["neutrals", "accents"],
+      "properties": {
+        "neutrals": {
+          "type": "object",
+          "description": "4-5 role-based neutral shades.",
+          "required": ["background", "surface", "border", "textPrimary"],
+          "properties": {
+            "background": { "type": "string" },
+            "surface": { "type": "string" },
+            "border": { "type": "string" },
+            "textPrimary": { "type": "string" },
+            "textSecondary": { "type": "string" },
+            "temperature": { "type": "string", "enum": ["warm", "cool", "neutral"], "description": "Intent behind the grey undertone." }
+          }
+        },
+        "accents": {
+          "type": "object",
+          "description": "1-3 bold action/emphasis colors plus semantic status colors.",
+          "properties": {
+            "primary": { "type": "string" },
+            "onPrimary": { "type": "string", "description": "Text/icon color used on a primary-accent fill. Must meet contrastStandard against accents.primary." },
+            "secondary": { "type": "string" },
+            "success": { "type": "string" },
+            "warning": { "type": "string" },
+            "error": { "type": "string" },
+            "info": { "type": "string" }
+          }
+        },
+        "themes": {
+          "type": "array",
+          "description": "Color themes, first = primary. Omit for a single light theme.",
+          "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } } },
+          "default": [{ "id": "light", "name": "Light" }]
+        },
+        "resolved": {
+          "type": "object",
+          "description": "Real color values for every role, per theme — required for Claude Design, and the only place contrast can actually be computed. Keys are role paths ('neutrals.background', 'accents.primary', 'interactionStates.hover'); values map theme id → a hex/rgb/hsl/oklch value.",
+          "additionalProperties": {
+            "type": "object",
+            "additionalProperties": { "type": "string" }
+          }
+        },
+        "contrastStandard": {
+          "type": "string",
+          "enum": ["WCAG-AA", "WCAG-AAA"],
+          "default": "WCAG-AA",
+          "description": "Which contrast ratio table the audit step checks colors against."
+        },
+        "interactionStates": {
+          "type": "object",
+          "description": "Colors that must visually distinguish an element the user is actively interacting with from the rest of the page — this is what lets hover/focus draw the eye.",
+          "properties": {
+            "hover": { "type": "string", "description": "Applied on hover. Must differ from the element's resting color AND from the page background — not just a subtle opacity shift." },
+            "active": { "type": "string", "description": "Applied while pressed/activated." },
+            "focus": { "type": "string", "description": "Applied on keyboard focus — can equal hover but must remain visible without a pointer." }
+          }
+        },
+        "usagePolicy": {
+          "type": "object",
+          "description": "Governs how the two key action colors are allowed to coexist on one screen.",
+          "properties": {
+            "primaryAccentRole": { "type": "string", "default": "accents.primary", "description": "The default action color, used freely." },
+            "secondaryAccentRole": { "type": "string", "default": "accents.secondary", "description": "The contrasting action color, reserved for a single competing action." },
+            "maxSimultaneousSecondaryAccents": {
+              "type": "integer",
+              "default": 1,
+              "description": "Max number of times the secondary accent color may appear on screen at once. Keeps the secondary color meaningful as 'the other choice' rather than diluting into decoration."
+            },
+            "maxPrimaryActionsPerScreen": {
+              "type": "integer",
+              "default": 1,
+              "description": "Every screen has one primary action, full stop — per the Hierarchy Drives Everything principle. Secondary actions must not use primary-accent-weight styling regardless of how important they feel; if two actions both seem primary, that's an information-architecture problem to resolve (see compositionHeuristics), not a reason to raise this number."
+            }
+          }
+        }
+      }
+    },
+
+    "typography": {
+      "type": "object",
+      "required": ["typefaces", "scale"],
+      "properties": {
+        "typefaces": {
+          "type": "object",
+          "description": "Max 2-3 typefaces, role-assigned per the skill's display/text/caption split.",
+          "properties": {
+            "display": { "type": "string", "description": "Headlines, hero text." },
+            "body": { "type": "string", "description": "Paragraphs, long-form content." },
+            "ui": { "type": "string", "description": "Labels, buttons, captions. Can equal 'body'." }
+          }
+        },
+        "weights": {
+          "type": "array",
+          "items": { "type": "integer" },
+          "maxItems": 3,
+          "description": "e.g. [400, 500, 700]"
+        },
+        "scale": {
+          "type": "object",
+          "required": ["baseSizePx", "ratio"],
+          "properties": {
+            "baseSizePx": { "type": "number", "default": 16 },
+            "ratio": { "type": "number", "description": "1.25 = major third, 1.333 = perfect fourth, etc." },
+            "steps": {
+              "type": "array",
+              "items": { "type": "string" },
+              "description": "Named steps to generate, e.g. ['xs','sm','base','lg','xl','2xl','3xl','4xl','5xl']"
+            }
+          }
+        },
+        "lineHeightRatio": { "type": "number", "default": 1.5 },
+        "styles": {
+          "type": "array",
+          "description": "Named text styles: which step, weight and typeface each kind of text uses. The same kind of text is always the same style: every section heading uses 'section-heading', never xl on one screen and 2xl on another. Steps must be in scale.steps and weights in weights.",
+          "items": {
+            "type": "object",
+            "required": ["name", "step", "weight"],
+            "properties": {
+              "name": { "type": "string", "description": "e.g. 'page-title', 'section-heading', 'body', 'label', 'caption'." },
+              "step": { "type": "string", "description": "A scale.steps name." },
+              "weight": { "type": "integer" },
+              "typeface": { "type": "string", "enum": ["display", "body", "ui"] },
+              "appliesTo": { "type": "array", "items": { "type": "string" }, "description": "Elements it applies to, e.g. ['h1'] or ['label']." },
+              "usage": { "type": "string" }
+            }
+          }
+        },
+        "roles": {
+          "type": "object",
+          "description": "Explicit pairing rules so the agent doesn't have to infer hierarchy — a header and its subtext must read as visually distinct, and a subtext next to an input must read differently than a subtext that's just explanatory prose.",
+          "properties": {
+            "heading": {
+              "type": "string",
+              "default": "typefaces.display",
+              "description": "Must be visually heavier/more prominent than readableSubtext — different family, weight, or size step, not just color."
+            },
+            "readableSubtext": {
+              "type": "string",
+              "default": "typefaces.body",
+              "description": "Explanatory/descriptive text under a heading. Should read as lighter and less visually taxing than the heading — lower weight and/or a muted text color role."
+            },
+            "formLabel": {
+              "type": "string",
+              "default": "typefaces.ui",
+              "description": "Subtext specifically for fields the user must fill in, as opposed to text they only read. Must be styled distinctly from readableSubtext (e.g. different weight, case, or color) so 'this needs input' is visually distinguishable from 'this is just describing something' at a glance."
+            }
+          }
+        }
+      }
+    },
+
+    "spacing": {
+      "type": "object",
+      "required": ["baseUnitPx", "scale"],
+      "properties": {
+        "baseUnitPx": { "type": "number", "default": 4 },
+        "scale": {
+          "type": "array",
+          "items": { "type": "number" },
+          "description": "e.g. [4, 8, 16, 24, 32, 48]"
