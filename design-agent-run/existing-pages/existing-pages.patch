+/**
+ * Fuji primitive rules from the standalone audits of the pre-harness pages
+ * (design-agent-run/existing-pages/): 44px targets, wrapping labels, token
+ * hover, and one select style.
+ */
+import { describe, it, expect } from 'vitest';
+import { buttonClasses } from '@/components/primitives/buttonClasses';
+import { inputClasses } from '@/components/primitives/inputClasses';
+import { selectClasses } from '@/components/primitives/selectClasses';
+
+describe('primitive touch targets and wrapping', () => {
+  it('every button size is at least 44px and may wrap', () => {
+    for (const size of ['sm', 'md', 'lg'] as const) {
+      const c = buttonClasses({ size });
+      expect(c).toContain('min-h-11');
+      expect(c).toContain('whitespace-normal');
+      expect(c).not.toContain('whitespace-nowrap');
+    }
+  });
+
+  it('hover darkens to the active token and never turns text mint', () => {
+    expect(buttonClasses({ variant: 'primary' })).toContain('hover:bg-[var(--color-accent-deep)]');
+    expect(buttonClasses({ variant: 'primary' })).not.toContain('hover:opacity-90');
+    expect(buttonClasses({ variant: 'secondary' })).toContain('hover:text-[var(--color-accent-text)]');
+    expect(buttonClasses({ variant: 'secondary' })).not.toContain('hover:text-[var(--color-accent)]');
+  });
+
+  it('inputs and selects are 44px; selects keep the native arrow', () => {
+    expect(inputClasses()).toContain('min-h-11');
+    const s = selectClasses();
+    expect(s).toContain('min-h-11');
+    expect(s).toContain('px-3');
+    expect(s).not.toContain('appearance-none');
+    expect(selectClasses({ mono: true })).toContain('adp-mono');
+  });
+});
