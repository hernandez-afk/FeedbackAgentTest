@@ -0,0 +1,21 @@
+/**
+ * selectClasses — the one approved native <select> style (Fuji NativeSelect
+ * pattern, first shipped in SessionsFilters, CH-479).
+ *
+ * Added by the standalone audits of the pre-harness pages
+ * (design-agent-run/existing-pages/): three pages hand-rolled their own
+ * select, two of them with `appearance-none`, which dropped the padding and
+ * the dropdown arrow and left a 26px control. This keeps the native arrow,
+ * pads the text off the border, and is 44px tall (minTouchTargetPx).
+ *
+ * No 'use client' — safe in server components.
+ */
+import { INPUT_BASE_CLASS } from './inputClasses';
+
+export function selectClasses({
+  mono = false,
+  className = '',
+}: { mono?: boolean; className?: string } = {}): string {
+  const base = INPUT_BASE_CLASS.replace('adp-body', mono ? 'adp-mono' : 'adp-body');
+  return `${base} px-3 py-2 min-w-0 max-w-full disabled:opacity-50 disabled:cursor-not-allowed ${className}`.trim();
+}
