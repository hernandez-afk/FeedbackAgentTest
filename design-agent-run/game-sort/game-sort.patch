+/**
+ * GameListRow - one game in the /games LIST view (GFE-SORT).
+ *
+ * Design record: design-agent-run/game-sort/ (Design System Agent run).
+ *
+ * Server Component. The compact counterpart to GameCard: the same title
+ * link, the same meta line (lib/game-meta.ts) and the same build-count Badge,
+ * so switching views never changes what a game says about itself
+ * (Consistency; Wickens 13). What it leaves out is deliberate progressive
+ * disclosure: no build pills, and none of the admin management controls
+ * (Manage builds, Archive, Delete). The list view exists to SCAN a long
+ * catalogue; picking a build still happens on the game's own page, which the
+ * title opens (the same destination the card's build pill + Continue reaches
+ * since CH-378), and management stays in the card view.
+ *
+ * The header actions the brief lists - View dashboard, Import documents,
+ * Edit - are kept, behind exactly the gates GameCard uses (canReview,
+ * canManage), so a row never offers a control its card would hide.
+ *
+ * Layout: phone first. At the narrowest width the row stacks (title + meta,
+ * then the actions wrapping below); from `sm:` the actions sit on the right
+ * of the same row. The title is a stretched link like GameCard's (CH-376),
+ * with the actions lifted above it (`relative z-10`) so they stay clickable.
+ */
+import Link from 'next/link';
+import Badge from '@/components/primitives/Badge';
+import HighlightedText from '@/components/HighlightedText';
+import { buttonClasses } from '@/components/primitives/buttonClasses';
+import { gameMetaParts } from '@/lib/game-meta';
+import { slugify } from '@/lib/slug';
+import type { Game } from '@/lib/types';
+
+export type GameListRowProps = {
+  game: Game;
+  /** Reviewer gate for View dashboard + Import documents (same as GameCard). */
+  canReview?: boolean;
+  /** Per-game management gate for Edit (GameOut.can_manage, CH-621). */
+  canManage?: boolean;
+  /** Active search term, highlighted in the title (CH-606). */
+  highlightTerm?: string;
+  /** Include the studio name in the meta line. */
+  showStudio?: boolean;
+};
+
+export default function GameListRow({
+  game,
+  canReview = false,
+  canManage = false,
+  highlightTerm = '',
+  showStudio = false,
+}: GameListRowProps): React.JSX.Element {
+  const buildLabel = game.build_count === 1 ? '1 build' : `${game.build_count} builds`;
+  const hasSlug = typeof game.slug === 'string' && game.slug.length > 0;
+  const playHref = hasSlug ? `/game/${slugify(game.slug as string)}` : null;
+  const metaParts = gameMetaParts(game, { showStudio });
+  const hasActions = canReview || canManage;
+
+  return (
+    <li>
+      <article
+        aria-label={game.title}
+        className={[
+          'relative flex flex-col gap-3 rounded-[var(--radius-lg)] border border-[var(--color-hair)] px-4 py-3',
+          'sm:flex-row sm:items-center sm:gap-4',
+          playHref !== null ? 'transition-colors hover:bg-[var(--color-surface-2)]' : '',
+        ]
+          .filter(Boolean)
+          .join(' ')}
+        style={{ background: 'var(--color-surface)' }}
+      >
+        <div className="min-w-0 flex-1">
+          <div className="flex items-start justify-between gap-3 sm:justify-start">
+            <h2 className="adp-h2 min-w-0 break-words" style={{ color: 'var(--color-ink)' }}>
+              {playHref !== null ? (
+                <Link
+                  href={playHref}
+                  className="underline-offset-2 hover:underline focus-visible:underline after:content-[''] after:absolute after:inset-0"
+                  style={{ color: 'inherit' }}
+                  aria-label={`How to play ${game.title}`}
+                >
+                  <HighlightedText text={game.title} term={highlightTerm} />
+                </Link>
+              ) : (
+                <HighlightedText text={game.title} term={highlightTerm} />
+              )}
+            </h2>
+            <Badge
+              variant={game.build_count > 0 ? 'info' : 'neutral'}
+              size="sm"
+              pill={false}
+              className="shrink-0 mt-0.5"
+              aria-label={`${buildLabel} available`}
+            >
+              {buildLabel}
+            </Badge>
+          </div>
+          {metaParts.length > 0 && (
+            <p
+              className="adp-mono mt-0.5 break-words"
+              style={{ color: 'var(--color-ink-faint)' }}
+              data-testid="game-meta"
+            >
+              {metaParts.join(' · ')}
+            </p>
+          )}
+        </div>
+
+        {hasActions && (
+          <div className="relative z-10 flex flex-wrap items-center gap-2 sm:shrink-0 sm:justify-end">
+            {canReview && (
+              <Link
+                href={`/games/${encodeURIComponent(game.id)}/dashboard`}
+                className={buttonClasses({ variant: 'secondary', size: 'sm' })}
+                aria-label={`View dashboard for ${game.title}`}
+              >
+                View dashboard
+              </Link>
+            )}
+            {canReview && (
+              <Link
+                href={`/imports?game=${encodeURIComponent(game.id)}`}
+                className={buttonClasses({ variant: 'secondary', size: 'sm' })}
+                aria-label={`Import documents onto ${game.title}`}
+              >
+                Import documents
+              </Link>
+            )}
+            {canManage && (
+              <Link
+                href={`/games/${encodeURIComponent(game.id)}/edit`}
+                className={buttonClasses({ variant: 'secondary', size: 'sm' })}
+                aria-label={`Edit ${game.title}`}
+              >
+                Edit
+              </Link>
+            )}
+          </div>
+        )}
+      </article>
+    </li>
+  );
+}
