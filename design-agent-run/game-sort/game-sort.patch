+"""GFE-SORT round 2: projects, titles (franchise), stars, the critical flag,
+the sidebar navigation read, and case-insensitive platforms.
+
+Pinned, and why:
+  * "MSN" / "msn" / "MSN " are ONE platform (the author's rule) - one facet
+    option, and filtering by any spelling finds every spelling;
+  * project and title are set by NAME on create/edit, get-or-create,
+    case-insensitively (no duplicate "Andreas Sketches" rows), and cleared by
+    null;
+  * a star is private to its user, idempotent, and cannot target a game the
+    caller cannot see (404, not 403);
+  * critical = latest complete report >= 40% negative over >= 5 entries, and
+    is hidden (None) from non-reviewers, whose "critical" sort falls back to
+    title order;
+  * the navigation read is scoped exactly like the list.
+
+Real Postgres via db_engine; skipped without DATABASE_URL (requires_db).
+"""
+from __future__ import annotations
+
+from typing import AsyncGenerator
+
+import httpx
+import pytest
+import pytest_asyncio
+
+from conftest import SEED_ADMIN_EMAIL, requires_db  # type: ignore[import-not-found]
+
+pytestmark = requires_db
+
+BEARER = "Bearer test-secret"
+VIEWER_EMAIL = "gfe-sort2-viewer@atari.com"
+EDITOR_EMAIL = "gfe-sort2-editor@atari.com"
+
+
+def _headers(email: str) -> dict[str, str]:
+    from session_token_helper import create_session_token  # type: ignore[import-not-found]
+
+    return {"Authorization": BEARER, "X-Session-Token": create_session_token(email)}
+
+
+@pytest_asyncio.fixture
+async def app(db_engine):
+    import server
+    from backend.db import get_async_db
+    from backend.models import (
+        AiEnrichmentReport,
+        AppUser,
+        EnrichmentStatus,
+        Game,
+        Studio,
+        UserRole,
+    )
+    from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker
+
+    maker = async_sessionmaker(bind=db_engine, expire_on_commit=False, class_=AsyncSession)
+    async with maker() as s:
+        a = Studio(name="Studio A")
+        b = Studio(name="Studio B")
+        s.add_all([a, b])
+        await s.flush()
+        ids = {"studio_a": str(a.id), "studio_b": str(b.id)}
+        games = {
+            "upper": Game(studio_id=a.id, title="Upper", platform="MSN"),
+            "lower": Game(studio_id=a.id, title="Lower", platform="msn"),
+            "spaced": Game(studio_id=a.id, title="Spaced", platform=" MSN "),
+            "blank": Game(studio_id=a.id, title="Blank", platform="  "),
+            "bad": Game(studio_id=a.id, title="Badly Reviewed", platform="Web"),
+            "fine": Game(studio_id=a.id, title="Fine Reviews", platform="Web"),
+            "few": Game(studio_id=a.id, title="Few Reviews", platform="Web"),
+            "other": Game(studio_id=b.id, title="Other Studio", platform="MSN"),
+        }
+        s.add_all(games.values())
+        await s.flush()
+        ids.update({k: str(g.id) for k, g in games.items()})
+
+        def report(game, negative: float, n: int) -> AiEnrichmentReport:
+            import datetime as dt
+
+            return AiEnrichmentReport(
+                game_id=game.id,
+                status=EnrichmentStatus.complete,
+                completed_at=dt.datetime.now(dt.timezone.utc),
+                entries_considered=n,
+                sentiment={"entries": [], "overall": {"negative_pct": negative}},
+            )
+
+        s.add_all(
+            [report(games["bad"], 55.0, 20), report(games["fine"], 10.0, 20), report(games["few"], 90.0, 2)]
+        )
+        s.add(AppUser(email=SEED_ADMIN_EMAIL, role=UserRole.admin, studio_id=None))
+        s.add(AppUser(email=VIEWER_EMAIL, role=UserRole.viewer, studio_id=a.id))
+        s.add(AppUser(email=EDITOR_EMAIL, role=UserRole.editor, studio_id=a.id))
+        await s.commit()
+
+    async def _db() -> AsyncGenerator[AsyncSession, None]:
+        async with maker() as sess:
+            yield sess
+
+    server.app.dependency_overrides[get_async_db] = _db
+    try:
+
+        def client() -> httpx.AsyncClient:
+            return httpx.AsyncClient(transport=httpx.ASGITransport(app=server.app), base_url="http://t")
+
+        yield client, ids
+    finally:
+        server.app.dependency_overrides.pop(get_async_db, None)
+
+
+async def _get(c, path, email=SEED_ADMIN_EMAIL, **params):
+    r = await c.get(path, params=params, headers=_headers(email))
+    assert r.status_code == 200, r.text
+    return r.json()
+
+
+@pytest.mark.asyncio
+async def test_platform_spellings_are_one_facet_and_one_filter(app):
+    client, _ = app
+    async with client() as c:
+        facets = await _get(c, "/api/games/facets", VIEWER_EMAIL)
+        titles = sorted(g["title"] for g in await _get(c, "/api/games", VIEWER_EMAIL, platform="msn"))
+    msn = [p for p in facets["platforms"] if p["value"] and p["value"].lower() == "msn"]
+    assert len(msn) == 1 and msn[0]["count"] == 3
+    # Blank-after-trim joins "no platform".
+    assert {"value": None, "count": 1} in facets["platforms"]
+    assert titles == ["Lower", "Spaced", "Upper"]
+
+
+@pytest.mark.asyncio
+async def test_project_and_title_get_or_create_case_insensitively(app):
+    client, ids = app
+    async with client() as c:
+        h = _headers(SEED_ADMIN_EMAIL)
+        r1 = await c.patch(f"/api/games/{ids['upper']}", json={"project": "Andreas Sketches", "franchise": "Asteroids"}, headers=h)
+        r2 = await c.patch(f"/api/games/{ids['lower']}", json={"project": " andreas sketches ", "franchise": "ASTEROIDS"}, headers=h)
+        assert r1.status_code == 200, r1.text
+        assert r2.status_code == 200, r2.text
+        assert r1.json()["project_id"] == r2.json()["project_id"]
+        assert r1.json()["franchise_id"] == r2.json()["franchise_id"]
+        assert r2.json()["project_name"] == "Andreas Sketches"
+
+        by_project = await _get(c, "/api/games", project=r1.json()["project_id"], sort="title")
+        assert [g["title"] for g in by_project] == ["Lower", "Upper"]
+        by_title = await _get(c, "/api/games", title=r1.json()["franchise_id"])
+        assert len(by_title) == 2
+        no_project = await _get(c, "/api/games", project="__none__")
+        assert "Upper" not in {g["title"] for g in no_project}
+
+        facets = await _get(c, "/api/games/facets")
+        named = [p for p in facets["projects"] if p["id"]]
+        assert named == [{"id": r1.json()["project_id"], "name": "Andreas Sketches", "count": 2}]
+
+        cleared = await c.patch(f"/api/games/{ids['lower']}", json={"project": None}, headers=h)
+        assert cleared.json()["project_id"] is None
+
+
+@pytest.mark.asyncio
+async def test_bad_project_id_is_rejected_not_ignored(app):
+    client, _ = app
+    async with client() as c:
+        r = await c.get("/api/games", params={"project": "nope"}, headers=_headers(SEED_ADMIN_EMAIL))
+    assert r.status_code == 422
+
+
+@pytest.mark.asyncio
+async def test_star_is_private_idempotent_and_drives_the_starred_sort(app):
+    client, ids = app
+    async with client() as c:
+        hv = _headers(VIEWER_EMAIL)
+        for _ in range(2):
+            assert (await c.put(f"/api/games/{ids['spaced']}/favorite", headers=hv)).status_code == 204
+        mine = await _get(c, "/api/games", VIEWER_EMAIL, sort="starred")
+        assert mine[0]["title"] == "Spaced" and mine[0]["is_favorite"] is True
+        theirs = await _get(c, "/api/games", SEED_ADMIN_EMAIL, sort="starred")
+        assert not any(g["is_favorite"] for g in theirs)
+        assert (await c.delete(f"/api/games/{ids['spaced']}/favorite", headers=hv)).status_code == 204
+        assert (await c.delete(f"/api/games/{ids['spaced']}/favorite", headers=hv)).status_code == 204
+        after = await _get(c, "/api/games", VIEWER_EMAIL)
+        assert not any(g["is_favorite"] for g in after)
+
+
+@pytest.mark.asyncio
+async def test_cannot_star_a_game_outside_scope(app):
+    client, ids = app
+    async with client() as c:
+        r = await c.put(f"/api/games/{ids['other']}/favorite", headers=_headers(VIEWER_EMAIL))
+    assert r.status_code == 404
+
+
+@pytest.mark.asyncio
+async def test_critical_means_overly_negative_reviews(app):
+    client, _ = app
+    async with client() as c:
+        rows = {g["title"]: g["has_critical"] for g in await _get(c, "/api/games", EDITOR_EMAIL, platform="Web")}
+        ordered = await _get(c, "/api/games", EDITOR_EMAIL, sort="critical", platform="Web")
+    assert rows == {"Badly Reviewed": True, "Fine Reviews": False, "Few Reviews": False}
+    assert ordered[0]["title"] == "Badly Reviewed"
+
+
+@pytest.mark.asyncio
+async def test_critical_is_hidden_from_non_reviewers(app):
+    client, _ = app
+    async with client() as c:
