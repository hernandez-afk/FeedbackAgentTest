+// @vitest-environment jsdom
+/**
+ * GFE-SORT: GameFilterPanel (the /games Platform + Studio facets) and the
+ * GamesCatalogBrowser wiring around it: picking a facet, removing a chip,
+ * clearing filters, switching view and opening the phone panel all navigate
+ * through the one router.replace, with the full state in the URL.
+ */
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+const { replaceMock, pushMock } = vi.hoisted(() => ({
+  replaceMock: vi.fn(),
+  pushMock: vi.fn(),
+}));
+
+vi.mock('next/navigation', () => ({
+  useRouter: () => ({ push: pushMock, replace: replaceMock, prefetch: vi.fn() }),
+}));
+
+import { act } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import GameFilterPanel, { FACET_VISIBLE_OPTIONS, type FacetsState } from '@/components/GameFilterPanel';
+import GamesCatalogBrowser from '@/components/GamesCatalogBrowser';
+import type { GameFilters, GamesView } from '@/lib/game-search';
+
+const STUDIO_A = '11111111-1111-4111-8111-111111111111';
+const STUDIO_B = '22222222-2222-4222-8222-222222222222';
+
+const FACETS: FacetsState = {
+  ok: true,
+  facets: {
+    platforms: [
+      { value: 'MSN', count: 3 },
+      { value: 'Switch', count: 1 },
+      { value: null, count: 12 },
+    ],
+    studios: [
+      { id: STUDIO_A, name: 'Alpha Studio', count: 14 },
+      { id: STUDIO_B, name: 'Bravo Studio', count: 2 },
+    ],
+  },
+};
+
+let container: HTMLDivElement;
+let root: Root;
+
+beforeEach(() => {
+  replaceMock.mockReset();
+  pushMock.mockReset();
+  container = document.createElement('div');
+  document.body.appendChild(container);
+  root = createRoot(container);
+});
+
+afterEach(() => {
+  act(() => root.unmount());
+  container.remove();
+});
+
+function buttons(): HTMLButtonElement[] {
+  return Array.from(container.querySelectorAll('button'));
+}
+
+function button(text: string): HTMLButtonElement {
+  const found = buttons().find(
+    (b) => b.getAttribute('aria-label') === text || b.textContent?.trim().startsWith(text),
+  );
+  if (!found) throw new Error(`button not found: ${text}`);
+  return found;
+}
+
+function click(el: HTMLElement): void {
+  act(() => {
+    el.dispatchEvent(new MouseEvent('click', { bubbles: true }));
+  });
+}
+
+describe('GameFilterPanel', () => {
+  function renderPanel(filters: GameFilters, facets: FacetsState = FACETS, onToggle = vi.fn()) {
+    act(() => root.render(<GameFilterPanel facets={facets} filters={filters} onToggle={onToggle} />));
+    return onToggle;
+  }
+
+  it('lists each option with its count, "No platform" last, pressed state from the filters', () => {
+    renderPanel({ platforms: ['MSN'], studios: [] });
+    const msn = button('MSN');
+    expect(msn.getAttribute('aria-pressed')).toBe('true');
+    expect(msn.textContent).toContain('3');
+    expect(button('Switch').getAttribute('aria-pressed')).toBe('false');
+    const platformRows = Array.from(
+      container.querySelectorAll('fieldset')[0]!.querySelectorAll('li button'),
+    ).map((b) => b.textContent);
+    expect(platformRows[platformRows.length - 1]).toContain('No platform');
+  });
+
+  it('calls onToggle with the facet and the backend value', () => {
+    const onToggle = renderPanel({ platforms: [], studios: [] });
+    click(button('No platform'));
+    click(button('Bravo Studio'));
+    expect(onToggle.mock.calls).toEqual([
+      ['platforms', '__none__'],
+      ['studios', STUDIO_B],
+    ]);
+  });
+
+  it('hides the Studio facet when only one studio is visible and none is selected', () => {
+    renderPanel({ platforms: [], studios: [] }, {
+      ok: true,
+      facets: { ...FACETS.ok && FACETS.facets, studios: [{ id: STUDIO_A, name: 'Alpha Studio', count: 14 }] },
+    } as FacetsState);
+    expect(container.textContent).not.toContain('Studio');
+    expect(container.textContent).toContain('Platform');
+  });
+
+  it('keeps a selected value the facets no longer list, so it can be removed', () => {
+    renderPanel({ platforms: ['Dreamcast'], studios: [] });
+    const stale = button('Dreamcast');
+    expect(stale.getAttribute('aria-pressed')).toBe('true');
+    expect(stale.textContent).toContain('0');
+  });
+
+  it('shows the first options then "Show all", and never hides a selected one', () => {
+    const platforms = Array.from({ length: FACET_VISIBLE_OPTIONS + 4 }, (_, i) => ({
+      value: `P${String(i).padStart(2, '0')}`,
+      count: 20 - i,
+    }));
+    const last = platforms[platforms.length - 1]!.value;
+    renderPanel(
+      { platforms: [last], studios: [] },
+      { ok: true, facets: { platforms, studios: [] } },
+    );
+    const rows = () => container.querySelectorAll('fieldset li button').length;
+    expect(rows()).toBe(FACET_VISIBLE_OPTIONS + 1);
+    click(button(`Show all ${platforms.length} platforms`));
+    expect(rows()).toBe(platforms.length);
+  });
+
+  it('says filters are unavailable when the facets read failed', () => {
+    renderPanel({ platforms: [], studios: [] }, { ok: false, message: 'HTTP 503' });
+    expect(container.textContent).toContain('Filters are unavailable');
+    expect(container.textContent).toContain('HTTP 503');
+  });
+
+  it('explains the empty case when no game has a platform yet', () => {
+    renderPanel({ platforms: [], studios: [] }, {
+      ok: true,
+      facets: { platforms: [{ value: null, count: 5 }], studios: [{ id: STUDIO_A, name: 'A', count: 5 }] },
+    });
+    expect(container.textContent).toContain('No platforms have been set');
+  });
+});
+
+describe('GamesCatalogBrowser with filters (GFE-SORT)', () => {
+  function renderBrowser(filters: GameFilters, view: GamesView = 'card', facets: FacetsState = FACETS) {
+    act(() =>
+      root.render(
+        <GamesCatalogBrowser
+          query=""
+          sort="newest"
+          resultCount={3}
+          resultCountCapped={false}
+          totalCount={16}
+          filters={filters}
+          view={view}
+          facets={facets}
+        >
+          <div data-testid="grid">grid</div>
+        </GamesCatalogBrowser>,
+      ),
+    );
+  }
+
+  it('picking a platform navigates with it, keeping the other filters and view', () => {
+    renderBrowser({ platforms: [], studios: [STUDIO_A] }, 'list');
+    click(button('MSN'));
+    expect(replaceMock).toHaveBeenCalledWith(
+      `/games?platform=MSN&studio=${STUDIO_A}&view=list`,
+      { scroll: false },
+    );
+    expect(pushMock).not.toHaveBeenCalled();
+  });
+
+  it('shows a removable chip per active filter, named, never a raw id', () => {
+    renderBrowser({ platforms: ['MSN'], studios: [STUDIO_B] });
+    const chips = container.querySelector('[aria-label="Active filters"]');
+    expect(chips?.textContent).toContain('MSN');
+    expect(chips?.textContent).toContain('Bravo Studio');
+    expect(chips?.textContent).not.toContain(STUDIO_B);
+    click(button('Remove filter: Studio Bravo Studio'));
+    expect(replaceMock).toHaveBeenLastCalledWith('/games?platform=MSN', { scroll: false });
+  });
+
+  it('"Clear filters" drops every filter in one navigation', () => {
+    renderBrowser({ platforms: ['MSN', 'Switch'], studios: [STUDIO_A] });
+    click(button('Clear filters'));
+    expect(replaceMock).toHaveBeenLastCalledWith('/games', { scroll: false });
+  });
+
+  it('switches view in one tap', () => {
+    renderBrowser({ platforms: [], studios: [] });
+    expect(button('Cards').getAttribute('aria-pressed')).toBe('true');
+    click(button('List'));
+    expect(replaceMock).toHaveBeenLastCalledWith('/games?view=list', { scroll: false });
+  });
+
+  it('offers the Most active sort and says what it means next to the count', () => {
+    renderBrowser({ platforms: [], studios: [] });
+    click(button('Most active'));
+    expect(replaceMock).toHaveBeenLastCalledWith('/games?sort=activity', { scroll: false });
+  });
+
+  it('counts a filtered list as narrowed ("3 of 16 games")', () => {
+    renderBrowser({ platforms: ['MSN'], studios: [] });
+    expect(container.querySelector('[data-testid="games-result-count"]')?.textContent).toBe(
+      '3 of 16 games',
+    );
+  });
+
+  it('the phone Filters toggle reports its state and the active count', () => {
+    renderBrowser({ platforms: ['MSN', 'Switch'], studios: [] });
+    const toggle = button('Filters (2)');
+    expect(toggle.getAttribute('aria-expanded')).toBe('false');
+    const panel = container.querySelector('#games-filter-panel')!;
+    expect(panel.className).toContain('hidden');
+    expect(panel.className).toContain('lg:block');
+    click(toggle);
+    expect(toggle.getAttribute('aria-expanded')).toBe('true');
+    expect(panel.className.split(' ')).toContain('block');
+  });
+
+  it('renders no panel, no view switch for a caller that passes no facets', () => {
+    act(() =>
+      root.render(
+        <GamesCatalogBrowser query="" sort="newest" resultCount={3} resultCountCapped={false} totalCount={3}>
+          <div />
+        </GamesCatalogBrowser>,
+      ),
+    );
+    expect(container.querySelector('#games-filter-panel')).toBeNull();
+    expect(buttons().some((b) => b.textContent === 'List')).toBe(false);
+  });
+});
diff --git a/frontend/__tests__/game-list-row.test.tsx b/frontend/__tests__/game-list-row.test.tsx
