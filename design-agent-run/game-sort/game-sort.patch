+/**
+ * game-meta - the one "meta line" under a game's title (GFE-SORT).
+ *
+ * The /games card (GameCard) and the list row (GameListRow) both show the
+ * same facts about a game in the same order - platform, studio, when it was
+ * added - so they are built here once. Two hand-built lines drift the first
+ * time one screen gains a field (Consistency; Wickens 13).
+ *
+ * Pure: no React, no DOM. Dates are formatted in UTC from a fixed month table
+ * so a Server Component and a test render the identical string.
+ */
+import type { Game } from '@/lib/types';
+
+// A fixed table, not Intl: `Intl.DateTimeFormat('en-GB', { month: 'short' })`
+// renders September as "Sep" or "Sept" depending on the ICU build, so the
+// same game would read differently on two runtimes.
+const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
+
+/** "Added 12 Sep 2026", or null when the date is absent or unparseable. */
+export function addedLabel(createdAt: string | null | undefined): string | null {
+  if (!createdAt) return null;
+  const ts = new Date(createdAt);
+  if (Number.isNaN(ts.getTime())) return null;
+  return `Added ${ts.getUTCDate()} ${MONTHS[ts.getUTCMonth()]} ${ts.getUTCFullYear()}`;
+}
+
+/**
+ * The meta parts for a game, in display order. `showStudio` is false for a
+ * caller who can only see one studio: repeating the same name on every card
+ * is noise, not information.
+ */
+export function gameMetaParts(game: Game, { showStudio }: { showStudio: boolean }): string[] {
+  const parts: string[] = [];
+  if (game.platform) parts.push(game.platform);
+  if (showStudio && game.studio_name) parts.push(game.studio_name);
+  const added = addedLabel(game.created_at);
+  if (added) parts.push(added);
+  return parts;
+}
