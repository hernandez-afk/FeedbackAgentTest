new file mode 100644
index 0000000..e36fb5d
--- /dev/null
+++ b/frontend/components/catalog/StarButton.tsx
@@ -0,0 +1,109 @@
+'use client';
+
+/**
+ * StarButton - star / unstar a game for the signed-in user (GFE-SORT).
+ *
+ * Acceptance criterion: "Want to be able to star favorite games". The star
+ * sits beside the game in the sidebar tree (Andreas Beijer's design) and on
+ * its card/row, and drives the "Starred" sort.
+ *
+ * Optimistic: the star flips at once and PUT/DELETE /api/games/{id}/favorite
+ * runs behind it (both idempotent server-side). On failure it flips back and
+ * says so in a polite live region beside the star (no Toast dependency, so
+ * the button works anywhere it is rendered). Then router.refresh() so a
+ * "Starred" ordering re-sorts.
+ *
+ * 44x44 target (manifest accessibility.minTouchTargetPx), aria-pressed, and
+ * a label naming the game, so a screen reader hears "Star Asteroids", not a
+ * bare "button". Filled vs outline is the second cue beside color.
+ */
+import { useState, useTransition } from 'react';
+import { useRouter } from 'next/navigation';
+
+export type StarButtonProps = {
+  gameId: string;
+  gameTitle: string;
+  starred: boolean;
+  className?: string;
+};
+
+export function StarIcon({ filled }: { filled: boolean }): React.JSX.Element {
+  return (
+    <svg
+      viewBox="0 0 16 16"
+      width="16"
+      height="16"
+      fill={filled ? 'currentColor' : 'none'}
+      stroke="currentColor"
+      strokeWidth="1.4"
+      strokeLinejoin="round"
+      aria-hidden="true"
+      focusable="false"
+    >
+      <path d="M8 1.8 L9.9 5.7 L14.2 6.3 L11.1 9.3 L11.8 13.6 L8 11.6 L4.2 13.6 L4.9 9.3 L1.8 6.3 L6.1 5.7 Z" />
+    </svg>
+  );
+}
+
+export default function StarButton({
+  gameId,
+  gameTitle,
+  starred: initial,
+  className = '',
+}: StarButtonProps): React.JSX.Element {
+  const router = useRouter();
+  const [error, setError] = useState<string | null>(null);
+  const [starred, setStarred] = useState(initial);
+  const [lastInitial, setLastInitial] = useState(initial);
+  const [, startTransition] = useTransition();
+  const [busy, setBusy] = useState(false);
+
+  // Follow the server's value after a refresh (render-time adjust, not an effect).
+  if (initial !== lastInitial) {
+    setLastInitial(initial);
+    setStarred(initial);
+  }
+
+  async function toggle(): Promise<void> {
+    if (busy) return;
+    const next = !starred;
+    setStarred(next);
+    setBusy(true);
+    setError(null);
+    try {
+      const res = await fetch(`/api/games/${encodeURIComponent(gameId)}/favorite`, {
+        method: next ? 'PUT' : 'DELETE',
+      });
+      if (!res.ok) throw new Error(`HTTP ${res.status}`);
+      startTransition(() => router.refresh());
+    } catch {
+      setStarred(!next);
+      setError(`Couldn't ${next ? 'star' : 'unstar'} ${gameTitle}. Try again.`);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <>
+    <button
+      type="button"
+      aria-pressed={starred}
+      aria-label={`${starred ? 'Unstar' : 'Star'} ${gameTitle}`}
+      onClick={toggle}
+      className={[
+        'inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-[var(--radius-button)]',
+        'transition-colors hover:bg-[var(--color-accent-08)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]',
+        className,
+      ].join(' ')}
+      style={{ color: starred ? 'var(--color-mixed)' : 'var(--color-ink-faint)' }}
+      data-starred={starred || undefined}
+    >
+      <StarIcon filled={starred} />
+    </button>
+    <span className="sr-only" role="status" aria-live="polite">
+      {error ?? ''}
+    </span>
+    </>
+  );
+}
