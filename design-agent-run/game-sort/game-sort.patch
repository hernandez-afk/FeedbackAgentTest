+def _parse_id_filter(values: list[str] | None, param: str) -> tuple[list[uuid.UUID], bool]:
+    """Split a repeatable id filter into (ids, wants_none).
+
+    ``GAME_FACET_NO_PLATFORM`` ("__none__") doubles as "no project" / "no
+    title". Anything else must be a UUID; a malformed value is a 422, not a
+    silently ignored filter (an ignored filter shows MORE than was asked for).
+    """
+    ids: list[uuid.UUID] = []
+    wants_none = False
+    for raw in values or []:
+        if raw == GAME_FACET_NO_PLATFORM:
+            wants_none = True
+            continue
+        try:
+            ids.append(uuid.UUID(raw))
+        except ValueError:
+            raise HTTPException(status_code=422, detail=f"Invalid {param} id.")
+    return sorted(set(ids)), wants_none
+
