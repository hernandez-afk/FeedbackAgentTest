+  nav('PopopoP', { platform: 'ALAN - 9', project_id: 'p1', project_name: 'Andreas Sketches', has_critical: true }),
+  nav('Ninja Soccer', { platform: 'ATARI - 7800', project_id: 'p1', project_name: 'Andreas Sketches' }),
