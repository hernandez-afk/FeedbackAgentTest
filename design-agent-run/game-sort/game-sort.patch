diff --git a/frontend/lib/title-groups.ts b/frontend/lib/title-groups.ts
new file mode 100644
index 0000000..b096563
--- /dev/null
+++ b/frontend/lib/title-groups.ts
@@ -0,0 +1,43 @@
+/**
+ * title-groups - fold a page of games into TITLE groups (GFE-SORT, option A
+ * approved by the author: "Asteroids -> Asteroids Arezion (MSN), Asteroids
+ * Classic Azerion (MSN)").
+ *
+ * Games sharing a `franchise_id` become one group, placed where its FIRST
+ * game appears, so the server's sort order still decides what comes first.
+ * A title with one game on the page stays a plain game: a "1 version" box
+ * is noise. Pure; used by /games for both the card and list views.
+ *
+ * Grouping is per PAGE: a title whose versions straddle the 50-game page
+ * boundary shows its remaining versions on the next page. The sidebar tree
+ * (the whole catalogue) always shows every version together.
+ */
+import type { Game } from '@/lib/types';
+
+export type PageEntry<T extends Game = Game> =
+  | { kind: 'game'; game: T; index: number }
+  | { kind: 'title'; id: string; name: string; games: { game: T; index: number }[] };
+
+export function groupByTitle<T extends Game>(games: T[]): PageEntry<T>[] {
+  const counts = new Map<string, number>();
+  for (const g of games) {
+    if (g.franchise_id) counts.set(g.franchise_id, (counts.get(g.franchise_id) ?? 0) + 1);
+  }
+  const entries: PageEntry<T>[] = [];
+  const groups = new Map<string, Extract<PageEntry<T>, { kind: 'title' }>>();
+  games.forEach((game, index) => {
+    const fid = game.franchise_id;
+    if (!fid || (counts.get(fid) ?? 0) < 2) {
+      entries.push({ kind: 'game', game, index });
+      return;
+    }
+    let group = groups.get(fid);
+    if (!group) {
+      group = { kind: 'title', id: fid, name: game.franchise_name ?? game.title, games: [] };
+      groups.set(fid, group);
+      entries.push(group);
+    }
+    group.games.push({ game, index });
+  });
+  return entries;
+}
