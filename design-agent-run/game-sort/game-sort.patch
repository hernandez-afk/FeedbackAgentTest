+def _id_clause(column: Any, ids: list[uuid.UUID], wants_none: bool) -> Any:
+    clauses = []
+    if ids:
+        clauses.append(column.in_(ids))
+    if wants_none:
+        clauses.append(column.is_(None))
+    return or_(*clauses)
 
 
