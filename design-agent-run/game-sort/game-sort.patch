--- /dev/null
+++ b/frontend/components/catalog/CatalogTree.tsx
@@ -0,0 +1,323 @@
+'use client';
+
+/**
+ * CatalogTree - the sidebar's Project -> Platform -> (Title) -> game tree
+ * (GFE-SORT, after Andreas Beijer's design).
+ *
+ * Design record: design-agent-run/game-sort/ (Design System Agent run).
+ *
+ * Data comes from GET /api/games/navigation (every visible game, in the
+ * current sort order), so the tree is the WHOLE catalogue, not the page the
+ * grid happens to show. Grouping:
+ *   1. Project cards ("Andreas Sketches"), A to Z, "No project" last.
+ *   2. Platform boxes inside each ("HTML5", "ALAN - 9"), grouped
+ *      case-insensitively ("MSN" = "msn", the author's rule), A to Z,
+ *      "No platform" last.
+ *   3. Games in the server's sort order. Two or more games sharing a TITLE
+ *      (franchise) under the same platform nest under that title, so
+ *      versions read as versions (option A, approved by the author).
+ * Each game carries its star (StarButton) and, for reviewers, the red "!"
+ * when its reviews have turned overly negative (CriticalFlag).
+ *
+ * Project and platform headers collapse (button + aria-expanded). The
+ * current game (the dashboard being viewed) is marked aria-current="page"
+ * and highlighted, so the sidebar doubles as "you are here".
+ *
+ * `filterText` narrows the tree to games whose title contains it
+ * (case-insensitive), the same match the backend's `q` uses, so the sidebar
+ * search box filters the tree instantly while the grid follows via the URL.
+ */
+import Link from 'next/link';
+import { useState } from 'react';
+import StarButton from '@/components/catalog/StarButton';
+import CriticalFlag from '@/components/catalog/CriticalFlag';
+import {
+  NO_PLATFORM_LABEL,
+  NO_PROJECT_LABEL,
+  type NavGame,
+} from '@/lib/game-search';
+import { slugify } from '@/lib/slug';
+
+export type CatalogTreeProps = {
+  items: NavGame[];
+  truncated?: boolean;
+  /** The game whose page is open, highlighted as "you are here". */
+  activeGameId?: string | null;
+  /** Reviewers open a game's dashboard; everyone else its play page. */
+  canReview?: boolean;
+  /** Narrow the tree to titles containing this text. */
+  filterText?: string;
+};
+
+type TitleEntry = { kind: 'title'; key: string; name: string; games: NavGame[] };
+type GameEntry = { kind: 'game'; game: NavGame };
+type Entry = TitleEntry | GameEntry;
+type PlatformGroup = { key: string; label: string; entries: Entry[] };
+type ProjectGroup = { key: string; label: string; platforms: PlatformGroup[] };
+
+const NONE_KEY = '\u0000none';
+
+function byLabelNoneLast<T extends { key: string; label: string }>(a: T, b: T): number {
+  if (a.key === NONE_KEY) return 1;
+  if (b.key === NONE_KEY) return -1;
+  return a.label.localeCompare(b.label, 'en', { sensitivity: 'base' });
+}
+
+/** Group nav rows into the tree. Pure; exported for tests. */
+export function buildTree(items: NavGame[]): ProjectGroup[] {
+  const projects = new Map<string, { label: string; platforms: Map<string, PlatformGroup> }>();
+  for (const game of items) {
+    const pKey = game.project_id ?? NONE_KEY;
+    let project = projects.get(pKey);
+    if (!project) {
+      project = { label: game.project_name ?? NO_PROJECT_LABEL, platforms: new Map() };
+      projects.set(pKey, project);
+    }
+    const trimmed = game.platform?.trim() ?? '';
+    const platKey = trimmed ? trimmed.toLowerCase() : NONE_KEY;
+    let platform = project.platforms.get(platKey);
+    if (!platform) {
+      platform = { key: platKey, label: trimmed || NO_PLATFORM_LABEL, entries: [] };
+      project.platforms.set(platKey, platform);
+    }
+    if (game.franchise_id) {
+      const existing = platform.entries.find(
+        (e): e is TitleEntry => e.kind === 'title' && e.key === game.franchise_id,
+      );
+      if (existing) {
+        existing.games.push(game);
+        continue;
+      }
+      platform.entries.push({
+        kind: 'title',
+        key: game.franchise_id,
+        name: game.franchise_name ?? game.title,
+        games: [game],
+      });
+    } else {
+      platform.entries.push({ kind: 'game', game });
+    }
+  }
+  return [...projects.entries()]
+    .map(([key, p]) => ({
+      key,
+      label: p.label,
+      platforms: [...p.platforms.values()]
+        .map((pl) => ({
+          ...pl,
+          // A title with one game is just that game.
+          entries: pl.entries.map((e): Entry =>
+            e.kind === 'title' && e.games.length === 1 ? { kind: 'game', game: e.games[0]! } : e,
+          ),
+        }))
+        .sort(byLabelNoneLast),
+    }))
+    .sort(byLabelNoneLast);
+}
+
+function Chevron({ open }: { open: boolean }): React.JSX.Element {
+  return (
+    <svg
+      viewBox="0 0 16 16"
+      width="12"
+      height="12"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth="1.75"
+      aria-hidden="true"
+      focusable="false"
+      className={`shrink-0 transition-transform ${open ? '' : '-rotate-90'}`}
+    >
+      <path d="M4 6 L8 10 L12 6" strokeLinecap="round" strokeLinejoin="round" />
+    </svg>
+  );
+}
+
+function gameHref(game: NavGame, canReview: boolean): string | null {
+  if (canReview) return `/games/${encodeURIComponent(game.id)}/dashboard`;
+  if (game.slug) return `/game/${slugify(game.slug)}`;
+  return null;
+}
+
+function GameLeaf({
+  game,
+  label,
+  active,
+  canReview,
+}: {
+  game: NavGame;
+  label?: string;
+  active: boolean;
+  canReview: boolean;
+}): React.JSX.Element {
+  const href = gameHref(game, canReview);
+  const text = label ?? game.title;
+  const linkClass = [
+    'flex min-h-[44px] min-w-0 flex-1 items-center rounded-[var(--radius-button)] px-2 py-1 adp-body text-[0.875rem] break-words',
+    'transition-colors hover:bg-[var(--color-accent-08)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]',
+    active ? 'bg-[var(--color-accent-15)] font-bold' : '',
+  ].join(' ');
+  return (
+    <li className="flex items-center gap-1" data-testid="tree-game">
+      {href ? (
+        <Link
+          href={href}
+          className={linkClass}
+          style={{ color: 'var(--color-ink)' }}
+          aria-current={active ? 'page' : undefined}
+        >
+          {text}
+        </Link>
+      ) : (
+        <span className={linkClass} style={{ color: 'var(--color-ink)' }}>
+          {text}
+        </span>
+      )}
+      {game.has_critical === true && <CriticalFlag />}
+      <StarButton gameId={game.id} gameTitle={game.title} starred={game.is_favorite} />
+    </li>
+  );
+}
+
+function Disclosure({
+  id,
+  header,
+  headerClass,
+  defaultOpen = true,
+  children,
+}: {
+  id: string;
+  header: React.ReactNode;
+  headerClass: string;
+  defaultOpen?: boolean;
+  children: React.ReactNode;
+}): React.JSX.Element {
+  const [open, setOpen] = useState(defaultOpen);
+  return (
+    <>
+      <button
+        type="button"
+        aria-expanded={open}
+        aria-controls={id}
+        onClick={() => setOpen((v) => !v)}
+        className={[
+          'flex min-h-[44px] w-full items-center gap-2 text-left transition-colors',
+          'focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]',
+          headerClass,
+        ].join(' ')}
+      >
+        <Chevron open={open} />
+        {header}
+      </button>
+      <div id={id} hidden={!open}>
+        {children}
+      </div>
+    </>
+  );
+}
+
+export default function CatalogTree({
+  items,
+  truncated = false,
+  activeGameId = null,
+  canReview = false,
+  filterText = '',
+}: CatalogTreeProps): React.JSX.Element {
+  const needle = filterText.trim().toLowerCase();
+  const shown = needle ? items.filter((g) => g.title.toLowerCase().includes(needle)) : items;
+  const tree = buildTree(shown);
+
+  if (items.length === 0) {
+    return (
+      <p className="adp-body" style={{ color: 'var(--color-ink-sub)' }}>
+        No games yet.
+      </p>
+    );
+  }
+  if (shown.length === 0) {
+    return (
+      <p className="adp-body" style={{ color: 'var(--color-ink-sub)' }} data-testid="tree-no-match">
+        No game titles contain &ldquo;{filterText.trim()}&rdquo;.
+      </p>
+    );
+  }
+
+  return (
+    <nav aria-label="Browse games" className="flex flex-col gap-4">
+      {tree.map((project, pi) => (
+        <section
+          key={project.key}
+          className="rounded-[var(--radius-lg)] border border-[var(--color-hair)] px-2 pb-2"
+          style={{ background: 'var(--color-surface)' }}
+        >
+          <Disclosure
+            id={`tree-project-${pi}`}
+            headerClass="px-2 adp-h2 hover:text-[var(--color-accent-text)]"
+            header={<span className="min-w-0 break-words">{project.label}</span>}
+          >
+            <div className="flex flex-col gap-3">
+              {project.platforms.map((platform, li) => (
+                <div
+                  key={platform.key}
+                  className="rounded-[var(--radius-button)] border border-[var(--color-hair)]"
+                >
+                  <Disclosure
+                    id={`tree-project-${pi}-platform-${li}`}
+                    headerClass="px-2 adp-mono font-bold hover:bg-[var(--color-accent-08)] rounded-[var(--radius-button)]"
+                    header={
+                      <span className="min-w-0 break-words" style={{ color: 'var(--color-ink)' }}>
+                        {platform.label}
+                      </span>
+                    }
+                  >
+                    <ul className="ml-4 flex flex-col border-l border-[var(--color-hair)] pb-1 pl-2">
+                      {platform.entries.map((entry) =>
+                        entry.kind === 'game' ? (
+                          <GameLeaf
+                            key={entry.game.id}
+                            game={entry.game}
+                            active={entry.game.id === activeGameId}
+                            canReview={canReview}
+                          />
+                        ) : (
+                          <li key={entry.key} data-testid="tree-title">
+                            <p
+                              className="adp-kicker flex min-h-[32px] items-center px-2"
+                              aria-label={`${entry.name}, ${entry.games.length} versions`}
+                            >
+                              {entry.name} · {entry.games.length} versions
+                            </p>
+                            <ul className="ml-2 flex flex-col border-l border-[var(--color-hair)] pl-2">
+                              {entry.games.map((g) => (
+                                <GameLeaf
+                                  key={g.id}
+                                  game={g}
+                                  active={g.id === activeGameId}
+                                  canReview={canReview}
+                                />
+                              ))}
+                            </ul>
+                          </li>
+                        ),
+                      )}
+                    </ul>
+                  </Disclosure>
+                </div>
+              ))}
+            </div>
+          </Disclosure>
+        </section>
+      ))}
+      {truncated && (
+        <p className="adp-mono" style={{ color: 'var(--color-ink-faint)' }}>
+          Showing the first 1,000 games. Search to find the rest.
+        </p>
+      )}
+      {canReview && (
+        <p className="adp-mono flex items-center gap-2" style={{ color: 'var(--color-ink-faint)' }}>
+          <CriticalFlag /> = reviews overly negative
+        </p>
+      )}
+    </nav>
+  );
+}
