@@ -0,0 +1,63 @@
+/**
+ * GFE-SORT: GameListRow - the compact /games list row. Pins that it offers
+ * exactly the controls its card would (same gates), and none of the
+ * management controls the list view deliberately leaves to card view.
+ */
+import { describe, it, expect } from 'vitest';
+import { renderToStaticMarkup } from 'react-dom/server';
+import GameListRow from '@/components/GameListRow';
+import type { Game } from '@/lib/types';
+
+const GAME = {
+  id: 'g1',
+  title: 'Asteroids Arezion',
+  platform: 'MSN',
+  studio_name: 'Alpha Studio',
+  created_at: '2026-09-12T08:00:00Z',
+  build_count: 1,
+  slug: 'asteroids-arezion',
+} as Game;
+
+function html(props: Partial<React.ComponentProps<typeof GameListRow>> = {}): string {
+  return renderToStaticMarkup(
+    <ul>
+      <GameListRow game={GAME} {...props} />
+    </ul>,
+  );
+}
+
+describe('GameListRow', () => {
+  it('links the title to the game page and shows the shared meta line + build badge', () => {
+    const out = html({ showStudio: true });
+    expect(out).toContain('href="/game/asteroids-arezion"');
+    expect(out).toContain('MSN · Alpha Studio · Added 12 Sep 2026');
+    expect(out).toContain('1 build');
+  });
+
+  it('fails closed: no actions without the gates', () => {
+    const out = html();
+    expect(out).not.toContain('View dashboard');
+    expect(out).not.toContain('Import documents');
+    expect(out).not.toContain('>Edit<');
+  });
+
+  it('reviewer gets dashboard + import; manage adds Edit', () => {
+    const out = html({ canReview: true, canManage: true });
+    expect(out).toContain('href="/games/g1/dashboard"');
+    expect(out).toContain('href="/imports?game=g1"');
+    expect(out).toContain('href="/games/g1/edit"');
+  });
+
+  it('never renders the card-only management controls', () => {
+    const out = html({ canReview: true, canManage: true });
+    expect(out).not.toContain('Manage builds');
+    expect(out).not.toContain('Archive');
+    expect(out).not.toContain('Delete');
+  });
+
+  it('renders a plain title when the game has no slug', () => {
+    const out = html({ game: { ...GAME, slug: null } });
+    expect(out).not.toContain('href="/game/');
+    expect(out).toContain('Asteroids Arezion');
+  });
+});
diff --git a/frontend/__tests__/game-sort-helpers.test.ts b/frontend/__tests__/game-sort-helpers.test.ts
new file mode 100644
index 0000000..4f0cfcd
--- /dev/null
+++ b/frontend/__tests__/game-sort-helpers.test.ts
@@ -0,0 +1,145 @@
+/**
+ * GFE-SORT: pure helpers behind the /games filters, view and "Most active"
+ * sort (lib/game-search.ts) and the shared meta line (lib/game-meta.ts).
+ *
+ * The URL is the state (CH-606 decision 1, inherited), so the round trip
+ * "searchParams -> normalized state -> href / backend path" is pinned exactly:
+ * a filter that silently drops out of the backend path would look fine on a
+ * one-page seed and miss every game past page 1 in production.
+ */
+import { describe, it, expect } from 'vitest';
+import {
+  GAME_FILTER_MAX_VALUES,
+  facetsRequestPath,
+  gamesHref,
+  gamesRequestPath,
+  hasGameFilters,
+  normalizeGameFilters,
+  normalizeGamesSort,
+  normalizeGamesView,
+  toggleGameFilter,
+} from '@/lib/game-search';
+import { addedLabel, gameMetaParts } from '@/lib/game-meta';
+import type { Game } from '@/lib/types';
+
+const STUDIO_A = '11111111-1111-4111-8111-111111111111';
+const STUDIO_B = '22222222-2222-4222-8222-222222222222';
+
+describe('normalizeGamesSort (GFE-SORT)', () => {
+  it('accepts activity, and still rejects anything unknown', () => {
+    expect(normalizeGamesSort('activity')).toBe('activity');
+    expect(normalizeGamesSort('ACTIVITY')).toBe('newest');
+  });
+});
+
+describe('normalizeGamesView', () => {
+  it('defaults to card and only accepts the literal list', () => {
+    expect(normalizeGamesView(undefined)).toBe('card');
+    expect(normalizeGamesView('list')).toBe('list');
+    expect(normalizeGamesView(['list', 'card'])).toBe('list');
+    expect(normalizeGamesView('grid')).toBe('card');
+  });
+});
+
+describe('normalizeGameFilters', () => {
+  it('reads single and repeated values, drops blanks and duplicates, keeps order', () => {
+    expect(normalizeGameFilters(['MSN', ' ', 'Switch', 'MSN'], undefined)).toEqual({
+      platforms: ['MSN', 'Switch'],
+      studios: [],
+    });
+    expect(normalizeGameFilters('MSN', STUDIO_A)).toEqual({
+      platforms: ['MSN'],
+      studios: [STUDIO_A],
+    });
+  });
+
+  it('drops a studio that is not a UUID rather than letting the backend 422 the page', () => {
+    expect(normalizeGameFilters(undefined, ['not-a-uuid', STUDIO_B]).studios).toEqual([STUDIO_B]);
+  });
+
+  it('caps each facet at the backend limit', () => {
+    const many = Array.from({ length: 30 }, (_, i) => `P${i}`);
+    expect(normalizeGameFilters(many, undefined).platforms).toHaveLength(GAME_FILTER_MAX_VALUES);
+  });
+});
+
+describe('toggleGameFilter / hasGameFilters', () => {
+  it('adds then removes a value on one facet only', () => {
+    const on = toggleGameFilter({ platforms: [], studios: [STUDIO_A] }, 'platforms', 'MSN');
+    expect(on).toEqual({ platforms: ['MSN'], studios: [STUDIO_A] });
+    expect(toggleGameFilter(on, 'platforms', 'MSN')).toEqual({ platforms: [], studios: [STUDIO_A] });
+    expect(hasGameFilters({ platforms: [], studios: [] })).toBe(false);
+    expect(hasGameFilters(on)).toBe(true);
+  });
+});
+
+describe('gamesRequestPath / facetsRequestPath with filters', () => {
+  const filters = { platforms: ['MSN', '__none__'], studios: [STUDIO_A] };
+
+  it('forwards every filter value to the backend list read', () => {
+    expect(gamesRequestPath('ast', 'activity', 50, filters)).toBe(
+      `/api/games?sort=activity&page_size=50&q=ast&platform=MSN&platform=__none__&studio=${STUDIO_A}`,
+    );
+  });
+
+  it('is byte-identical to before when there are no filters', () => {
+    expect(gamesRequestPath('', 'newest')).toBe('/api/games?sort=newest&page_size=50');
+  });
+
+  it('sends the facets read the same search and filters', () => {
+    expect(facetsRequestPath('', { platforms: [], studios: [] })).toBe('/api/games/facets');
+    expect(facetsRequestPath(' ast ', filters)).toBe(
+      `/api/games/facets?q=ast&platform=MSN&platform=__none__&studio=${STUDIO_A}`,
+    );
+  });
+});
+
+describe('gamesHref with filters and view', () => {
+  it('keeps defaults out of the URL and adds filters + view when set', () => {
+    expect(gamesHref('', 'newest', { platforms: [], studios: [] }, 'card')).toBe('/games');
+    expect(gamesHref('', 'newest', { platforms: ['MSN'], studios: [] }, 'list')).toBe(
+      '/games?platform=MSN&view=list',
+    );
+    expect(gamesHref('pong', 'activity', { platforms: [], studios: [STUDIO_A] })).toBe(
+      `/games?q=pong&sort=activity&studio=${STUDIO_A}`,
+    );
+  });
+
+  it('round-trips through normalizeGameFilters', () => {
+    const href = gamesHref('', 'title', { platforms: ['A B', 'C&D'], studios: [STUDIO_B] }, 'list');
+    const url = new URL(href, 'http://localhost');
+    expect(
+      normalizeGameFilters(url.searchParams.getAll('platform'), url.searchParams.getAll('studio')),
+    ).toEqual({ platforms: ['A B', 'C&D'], studios: [STUDIO_B] });
+    expect(normalizeGamesView(url.searchParams.get('view') ?? undefined)).toBe('list');
+  });
+});
+
+describe('game meta line', () => {
+  const game = {
+    id: 'g1',
+    title: 'Asteroids',
+    platform: 'MSN',
+    studio_name: 'Alpha Studio',
+    created_at: '2026-09-12T08:00:00Z',
+    build_count: 1,
+  } as Game;
+
+  it('orders platform, studio, added date', () => {
+    expect(gameMetaParts(game, { showStudio: true })).toEqual([
+      'MSN',
+      'Alpha Studio',
+      'Added 12 Sep 2026',
+    ]);
+  });
+
+  it('omits the studio when there is only one to see, and absent fields', () => {
+    expect(gameMetaParts(game, { showStudio: false })).toEqual(['MSN', 'Added 12 Sep 2026']);
+    expect(gameMetaParts({ ...game, platform: null, created_at: null }, { showStudio: false })).toEqual([]);
+  });
+
+  it('formats in UTC and ignores unparseable dates', () => {
+    expect(addedLabel('2026-09-12T23:30:00-05:00')).toBe('Added 13 Sep 2026');
+    expect(addedLabel('not a date')).toBeNull();
+  });
+});
diff --git a/frontend/__tests__/games-page-filters.test.tsx b/frontend/__tests__/games-page-filters.test.tsx
new file mode 100644
index 0000000..df7ae8d
--- /dev/null
+++ b/frontend/__tests__/games-page-filters.test.tsx
@@ -0,0 +1,168 @@
+/**
+ * app/games/page.tsx - GFE-SORT filters, facets read and list view.
+ *
+ * Same approach as games-page-search.test.tsx: mock auth + backendFetch,
+ * render the Server Component to static markup, and assert the exact backend
+ * paths. The boundary under test: facet filters reach the SERVER (a local
+ * filter over one page would pass on a seed and fail in production), the
+ * facets read failing never fails the page, and the list view renders rows
+ * without the per-game builds reads the card view needs.
+ */
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { renderToStaticMarkup } from 'react-dom/server';
+
+const { mockAuth, mockBackendFetch } = vi.hoisted(() => ({
+  mockAuth: vi.fn<() => Promise<{ user: Record<string, unknown> } | null>>(),
+  mockBackendFetch: vi.fn<(path: string, email: string) => Promise<Response>>(),
+}));
+
+vi.mock('@/auth', () => ({ auth: mockAuth }));
+vi.mock('@/lib/backend-fetch.server', () => ({ backendFetch: mockBackendFetch }));
+vi.mock('@/components/BuildPills', () => ({ default: () => <div data-testid="build-pills" /> }));
+vi.mock('@/components/ArchivedGamesPanel', () => ({ default: () => <div /> }));
+vi.mock('@/components/GamesCatalogBrowser', () => ({
+  default: ({
+    view,
+    filters,
+    facets,
+    totalCount,
+    children,
+  }: {
+    view?: string;
+    filters?: { platforms: string[]; studios: string[] };
+    facets?: { ok: boolean };
+    totalCount: number | null;
+    children: React.ReactNode;
+  }) => (
+    <div
+      data-testid="browser"
+      data-view={view}
+      data-platforms={filters?.platforms.join('|')}
+      data-facets-ok={String(facets?.ok)}
+      data-total-count={totalCount === null ? 'null' : String(totalCount)}
+    >
+      {children}
+    </div>
+  ),
+}));
+
+import GamesPage from '@/app/games/page';
+
+const STUDIO_A = '11111111-1111-4111-8111-111111111111';
+const GAMES = [
+  { id: 'g1', title: 'Asteroids', build_count: 1, slug: 'asteroids', platform: 'MSN', studio_name: 'Alpha', created_at: '2026-09-01T00:00:00Z', can_manage: true },
+  { id: 'g2', title: 'Centipede', build_count: 2, slug: 'centipede', platform: 'MSN', studio_name: 'Bravo', created_at: '2026-09-02T00:00:00Z' },
+];
+const FACETS = {
+  platforms: [{ value: 'MSN', count: 2 }],
+  studios: [
+    { id: STUDIO_A, name: 'Alpha', count: 1 },
+    { id: '22222222-2222-4222-8222-222222222222', name: 'Bravo', count: 1 },
+  ],
+};
+
+function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), { status, headers: { 'content-type': 'application/json' } });
+}
+
+function render(params: Record<string, string | string[]> = {}) {
+  return GamesPage({ searchParams: Promise.resolve(params) }).then((el) => renderToStaticMarkup(el));
+}
+
+function paths(): string[] {
+  return mockBackendFetch.mock.calls.map((c) => c[0]);
+}
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  mockAuth.mockResolvedValue({
+    user: { email: 'r@atari.com', isAdmin: false, canReview: true, isSuperAdmin: false },
+  });
+  mockBackendFetch.mockImplementation(async (path: string) => {
+    if (path.startsWith('/api/games/facets')) return json(FACETS);
+    if (path.startsWith('/api/games?')) return json(GAMES);
+    return json([]);
+  });
+});
+
+describe('facet filters reach the server', () => {
+  it('forwards repeated platform values and the studio to the list AND the facets read', async () => {
+    await render({ platform: ['MSN', '__none__'], studio: STUDIO_A });
+    expect(paths()).toContain(
+      `/api/games?sort=newest&page_size=50&platform=MSN&platform=__none__&studio=${STUDIO_A}`,
+    );
+    expect(paths()).toContain(`/api/games/facets?platform=MSN&platform=__none__&studio=${STUDIO_A}`);
+  });
+
+  it('treats a filtered list as narrowed and sizes the catalogue for "N of M"', async () => {
+    const html = await render({ platform: 'MSN' });
+    expect(paths()).toContain('/api/games?sort=newest&page_size=200');
+    expect(html).toContain('data-total-count="2"');
+  });
+
+  it('forwards sort=activity', async () => {
+    await render({ sort: 'activity' });
+    expect(paths()).toContain('/api/games?sort=activity&page_size=50');
+  });
+});
+
+describe('list view', () => {
+  it('renders list rows and skips the per-game builds reads', async () => {
+    const html = await render({ view: 'list' });
+    expect(html).toContain('data-view="list"');
+    expect(html).toContain('aria-label="Games"');
+    expect(html).not.toContain('data-testid="build-pills"');
+    expect(paths().some((p) => p.includes('/builds'))).toBe(false);
+    // Studio shows: the facets say two studios are visible.
+    expect(html).toContain('MSN · Alpha · Added 1 Sep 2026');
+    // Edit is gated per game on can_manage.
+    expect(html).toContain('aria-label="Edit Asteroids"');
+    expect(html).not.toContain('aria-label="Edit Centipede"');
+  });
+
+  it('card view still reads builds per game', async () => {
+    await render();
+    expect(paths().filter((p) => p.endsWith('/builds'))).toHaveLength(2);
+  });
+});
+
+describe('failure and empty states', () => {
+  it('still renders the catalogue when the facets read fails (AC10)', async () => {
+    mockBackendFetch.mockImplementation(async (path: string) => {
+      if (path.startsWith('/api/games/facets')) return json({ detail: 'boom' }, 500);
+      if (path.startsWith('/api/games?')) return json(GAMES);
+      return json([]);
+    });
+    // List view: the real GameCard needs a mounted app router, which a static
+    // render does not have; the list row is a pure Server Component.
+    const html = await render({ view: 'list' });
+    expect(html).toContain('data-facets-ok="false"');
+    expect(html).toContain('Asteroids');
+    // Studio falls back to the page's own rows (two names -> shown).
+    expect(html).toContain('MSN · Alpha');
+  });
+
+  it('degrades a 200 with the wrong shape instead of crashing', async () => {
+    mockBackendFetch.mockImplementation(async (path: string) => {
+      if (path.startsWith('/api/games/facets')) return json([]);
+      if (path.startsWith('/api/games?')) return json(GAMES);
+      return json([]);
+    });
+    const html = await render();
+    expect(html).toContain('data-facets-ok="false"');
+  });
+
+  it('names the filters that matched nothing and clears them, keeping the search (AC9)', async () => {
+    mockBackendFetch.mockImplementation(async (path: string) => {
+      if (path.startsWith('/api/games/facets')) return json(FACETS);
+      if (path.startsWith('/api/games?sort=newest&page_size=50')) return json([]);
+      if (path.startsWith('/api/games?')) return json(GAMES);
+      return json([]);
+    });
+    const html = await render({ q: 'zz', platform: ['Dreamcast', '__none__'], studio: STUDIO_A, view: 'list' });
+    expect(html).toContain('No games match &quot;zz&quot; with these filters');
+    expect(html).toContain('Filtered by Dreamcast, No platform, Alpha.');
+    expect(html).toContain('href="/games?q=zz&amp;view=list"');
+    expect(html).toContain('Clear filters');
+  });
+});
diff --git a/frontend/__tests__/sessions-filters-platform.test.tsx b/frontend/__tests__/sessions-filters-platform.test.tsx
new file mode 100644
index 0000000..7b95b2f
--- /dev/null
+++ b/frontend/__tests__/sessions-filters-platform.test.tsx
@@ -0,0 +1,84 @@
+// @vitest-environment jsdom
+/**
+ * GFE-SORT: the /sessions Platform dropdown. Options come from the facets
+ * read; the value is the platform text (or __none__); picking one clears the
+ * game + build filters (a game from the old platform would AND the new one
+ * down to nothing) and resets to page 1.
+ */
+import { describe, it, expect, beforeEach, vi } from 'vitest';
+
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+const { pushMock, facetsMock } = vi.hoisted(() => ({ pushMock: vi.fn(), facetsMock: vi.fn() }));
+let currentSearchParams = new URLSearchParams();
+
+vi.mock('next/navigation', () => ({
+  useRouter: () => ({ push: pushMock, replace: vi.fn(), prefetch: vi.fn(), refresh: vi.fn() }),
+  usePathname: () => '/sessions',
+  useSearchParams: () => currentSearchParams,
+}));
+vi.mock('@/lib/catalog-api', () => ({
+  listGames: vi.fn(async () => []),
+  listBuilds: vi.fn(async () => ({ ok: true, data: [] })),
+  listGameFacets: facetsMock,
+}));
+
