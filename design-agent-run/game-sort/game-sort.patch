+    # -----------------------------------------------------------------------
+    # GET /api/games/facets — filter options + counts for /games (GFE-SORT)
+    #
+    # Declared BEFORE every /games/{game_id}/... route so the literal segment
+    # is matched first and never parsed as a UUID.
+    # -----------------------------------------------------------------------
+
+    @router.get(
+        "/games/facets",
+        response_model=GameFacetsOut,
+    )
+    async def list_game_facets(
+        user: CurrentUser = Depends(require_user),
+        db: AsyncSession = Depends(get_async_db),
+        q: Annotated[str | None, Query(max_length=GAME_SEARCH_MAX_CHARS)] = None,
+        platform: Annotated[
+            list[str] | None, Query(max_length=GAME_FILTER_MAX_VALUES)
+        ] = None,
+        studio: Annotated[
+            list[uuid.UUID] | None, Query(max_length=GAME_FILTER_MAX_VALUES)
+        ] = None,
+    ) -> GameFacetsOut:
+        """Platform and studio options for the /games filter panel, with counts.
+
+        Scoped exactly like ``list_games`` (the same ``scoped_query`` IN-subquery
+        and the same archived-out default), so a count never includes a game
+        the caller cannot see, and no other studio's name or catalogue size
+        can leak through it.
+
+        Counts are "how many games would be listed if you also picked this":
+        each facet's counts apply the search and the OTHER facet's selection,
+        but not its own (standard faceted search), so picking a second
+        platform never shows a misleading 0 next to it.
+        """
+        scoped_ids = scoped_query(Game, user=user, db=db).with_only_columns(Game.id)
+
+        def _base(*cols: Any) -> Any:
+            return (
+                select(*cols)
+                .where(Game.id.in_(scoped_ids))
+                .where(Game.archived_at.is_(None))
+            )
+
+        platform_stmt = _apply_game_filters(
+            _base(Game.platform, func.count(Game.id)),
+            q=q,
+            platform=None,
+            studio=studio,
+        ).group_by(Game.platform)
+        studio_stmt = _apply_game_filters(
+            _base(Studio.id, Studio.name, func.count(Game.id)).join(
+                Studio, Studio.id == Game.studio_id
+            ),
+            q=q,
+            platform=platform,
+            studio=None,
+        ).group_by(Studio.id, Studio.name)
+
+        platform_rows = (await db.execute(platform_stmt)).all()
+        studio_rows = (await db.execute(studio_stmt)).all()
+
+        # Most games first, then name; "no platform" always last so a real
+        # platform is never pushed below the catch-all bucket.
+        platforms = sorted(
+            (PlatformFacetOut(value=value, count=count) for value, count in platform_rows),
+            key=lambda f: (f.value is None, -f.count, (f.value or "").lower()),
+        )
+        studios = sorted(
+            (StudioFacetOut(id=sid, name=name, count=count) for sid, name, count in studio_rows),
+            key=lambda f: (-f.count, f.name.lower()),
+        )
+        return GameFacetsOut(platforms=platforms, studios=studios)
+
