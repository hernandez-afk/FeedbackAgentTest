--- /dev/null
+++ b/frontend/lib/pill-classes.ts
@@ -0,0 +1,31 @@
+/**
+ * pill-classes - the SortPillGroup look as a class composer (GFE-SORT).
+ *
+ * The /games View switch, the active-filter chips and the sidebar Sort row
+ * are all SortPillGroup (manifest components; CH-606's pill): radius-pill,
+ * 44px, accent fill when pressed. One composer so they can't drift (audit
+ * round 2: the sort row had grown its own radius and weight).
+ *
+ * Plain module (no 'use client'), like buttonClasses.
+ */
+import type { CSSProperties } from 'react';
+
+export function pillClass(isActive: boolean): string {
+  return [
+    'inline-flex min-h-[44px] items-center gap-2 rounded-full px-4 adp-mono text-[0.75rem]',
+    'border transition-all focus:outline-none',
+    'focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2',
+    'focus-visible:ring-offset-[var(--color-bg)]',
+    isActive
+      ? 'border-[var(--color-accent)] font-bold'
+      : 'border-[var(--color-hair)] text-[var(--color-ink-sub)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent-text)]',
+  ].join(' ');
+}
+
+/** Inline colours for the pressed state: `.adp-mono`'s semi-transparent ink
+ *  would otherwise blend to an AA failure on the accent fill (BuildPills). */
+export function pillStyle(isActive: boolean): CSSProperties {
+  return isActive
+    ? { background: 'var(--color-accent)', color: 'var(--color-accent-ink)' }
+    : { background: 'transparent' };
+}
