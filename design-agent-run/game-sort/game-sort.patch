+
+# GFE-SORT: catalogue facet filters (platform, studio) and the "Most active"
+# ordering. See ``_apply_game_filters`` for the filter semantics.
+#
+# ``platform`` is free text on the game row, so a game with NO platform has to
+# be selectable too (most seeded games have none). It is requested with this
+# sentinel rather than an empty string, which a query string cannot tell apart
+# from "parameter sent with no value".
+GAME_FACET_NO_PLATFORM = "__none__"
+# Max values per repeatable facet parameter. A facet is picked from a short
+# list the page was handed; anything longer is not a real selection.
+GAME_FILTER_MAX_VALUES = 20
+# "Most active" = sessions submitted in this many days, most first.
+GAME_ACTIVITY_WINDOW_DAYS = 30
+
+
+def _apply_game_filters(
+    stmt: Any,
+    *,
+    q: str | None,
+    platform: list[str] | None,
+    studio: list[uuid.UUID] | None,
+) -> Any:
+    """AND the catalogue's search + facet filters onto a Game statement.
+
+    Shared by ``list_games`` and ``list_game_facets`` so a facet count and the
+    list it narrows can never disagree about what a filter means. Every
+    filter NARROWS the caller's already-scoped set (the callers AND it onto a
+    ``scoped_query`` IN-subquery); none of them can widen it.
+
+    * ``platform`` — exact match on ``game.platform``, OR across the values
+      given. ``GAME_FACET_NO_PLATFORM`` selects games with no platform.
+    * ``studio`` — ``game.studio_id`` IN the ids given (OR across values).
+    * Different facets AND together: platform=MSN&studio=A is "MSN games
+      from studio A".
+    """
+    if q is not None and q.strip():
+        stmt = stmt.where(Game.title.ilike(_like_contains(q), escape="\\"))
+    if platform:
+        named = sorted({p for p in platform if p != GAME_FACET_NO_PLATFORM})
+        clauses = []
+        if named:
+            clauses.append(Game.platform.in_(named))
+        if GAME_FACET_NO_PLATFORM in platform:
+            clauses.append(Game.platform.is_(None))
+        stmt = stmt.where(or_(*clauses))
+    if studio:
+        stmt = stmt.where(Game.studio_id.in_(sorted(set(studio))))
+    return stmt
+
