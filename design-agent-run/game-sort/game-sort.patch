index 0000000..dcf262a
--- /dev/null
+++ b/frontend/components/GameFilterPanel.tsx
@@ -0,0 +1,272 @@
+'use client';
+
+/**
+ * GameFilterPanel - the /games "Filter" panel: Platform and Studio facets with
+ * a count per option (GFE-SORT).
+ *
+ * Design record: design-agent-run/game-sort/ (Design System Agent run).
+ *
+ * Presentational + a little local state ("Show all"): the parent
+ * (GamesCatalogBrowser) owns the URL and the navigation transition, so every
+ * pick goes through the SAME router.replace + dimmed-grid pending treatment
+ * the search box and sort pills already use (CH-606 decisions 1 and 2).
+ *
+ * Why toggle rows and not checkboxes or a <select>
+ * ------------------------------------------------
+ *  - Fuji has no Checkbox primitive, and a facet is several values picked at
+ *    once, which a single-value <select> (SessionsFilters) cannot express.
+ *  - Each option is a <button aria-pressed>, the same toggle semantics the
+ *    sort pills use, laid out as a full-width row so the whole row is the
+ *    44px touch target and the count sits right-aligned beside the name
+ *    (Wickens 9: the name and its count are read together).
+ *  - A pressed row carries TWO cues besides color: a check mark and
+ *    aria-pressed (Wickens 4, redundancy gain).
+ *
+ * Scale
+ * -----
+ *  Each facet shows the first FACET_VISIBLE_OPTIONS options (most games
+ *  first, from the backend) and a "Show all N" control, so a catalogue with
+ *  30 platforms does not push the grid a screen down on a phone. A selected
+ *  option is always shown even when it would sit past the cut, so the user
+ *  can see and undo what is applied (Wickens 11, knowledge in the world).
+ *
+ * A selected value the facets no longer list (a stale shared link, or a
+ * platform an admin just renamed) is still rendered, with count 0, so it can
+ * be removed from here as well as from its chip.
+ *
+ * Studio is hidden when the caller can see only one studio and none is
+ * selected: a one-option facet filters nothing (viewers are studio-scoped).
+ */
+import { useState } from 'react';
+import InlineError from '@/components/primitives/InlineError';
+import {
+  GAMES_NO_PLATFORM,
+  NO_PLATFORM_LABEL,
+  type GameFacets,
+  type GameFilters,
+} from '@/lib/game-search';
+
+/** Options shown per facet before "Show all". */
+export const FACET_VISIBLE_OPTIONS = 8;
+
+export type FacetsState =
+  | { ok: true; facets: GameFacets }
+  | { ok: false; message: string };
+
+export type GameFilterPanelProps = {
+  facets: FacetsState;
+  filters: GameFilters;
+  onToggle: (facet: keyof GameFilters, value: string) => void;
+  /** Prefix for element ids, so two panels on one page never collide. */
+  idPrefix?: string;
+};
+
+type FacetOption = { value: string; label: string; count: number };
+
+function CheckIcon(): React.JSX.Element {
+  return (
+    <svg
+      viewBox="0 0 16 16"
+      width="12"
+      height="12"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth="2"
+      aria-hidden="true"
+      focusable="false"
+    >
+      <path d="M3.5 8.5 L6.5 11.5 L12.5 4.5" strokeLinecap="round" strokeLinejoin="round" />
+    </svg>
+  );
+}
+
+/** Platform options, with the "no platform" bucket labelled and kept last. */
+export function platformOptions(facets: GameFacets, selected: string[]): FacetOption[] {
+  const options: FacetOption[] = facets.platforms.map((p) => ({
+    value: p.value ?? GAMES_NO_PLATFORM,
+    label: p.value ?? NO_PLATFORM_LABEL,
+    count: p.count,
+  }));
+  for (const value of selected) {
+    if (!options.some((o) => o.value === value)) {
+      options.push({
+        value,
+        label: value === GAMES_NO_PLATFORM ? NO_PLATFORM_LABEL : value,
+        count: 0,
+      });
+    }
+  }
+  return options;
+}
+
+/** Studio options; an unknown selected id is labelled rather than shown raw. */
+export function studioOptions(facets: GameFacets, selected: string[]): FacetOption[] {
+  const options: FacetOption[] = facets.studios.map((s) => ({
+    value: s.id,
+    label: s.name,
+    count: s.count,
+  }));
+  for (const value of selected) {
+    if (!options.some((o) => o.value === value)) {
+      options.push({ value, label: 'Unknown studio', count: 0 });
+    }
+  }
+  return options;
+}
+
+function FacetGroup({
+  id,
+  legend,
+  noun,
+  options,
+  selected,
+  onToggle,
+}: {
+  id: string;
+  legend: string;
+  /** Plural noun for the "Show all N …" control, e.g. "platforms". */
+  noun: string;
+  options: FacetOption[];
+  selected: string[];
+  onToggle: (value: string) => void;
+}): React.JSX.Element {
+  const [expanded, setExpanded] = useState(false);
+  const overflow = options.length > FACET_VISIBLE_OPTIONS;
+  const visible =
+    expanded || !overflow
+      ? options
+      : options.filter(
+          (o, i) => i < FACET_VISIBLE_OPTIONS || selected.includes(o.value),
+        );
+
+  return (
+    <fieldset className="min-w-0">
+      <legend className="adp-kicker mb-2">{legend}</legend>
+      <ul id={`${id}-options`} className="flex flex-col gap-1">
+        {visible.map((option) => {
+          const isSelected = selected.includes(option.value);
+          return (
+            <li key={option.value}>
+              <button
+                type="button"
+                aria-pressed={isSelected}
+                onClick={() => onToggle(option.value)}
+                className={[
+                  'flex min-h-[44px] w-full items-center gap-3 rounded-[var(--radius-button)] px-3 py-2 text-left',
+                  'transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]',
+                  isSelected
+                    ? 'bg-[var(--color-accent-08)]'
+                    : 'hover:bg-[var(--color-surface-2)]',
+                ].join(' ')}
+              >
+                <span
+                  className={[
+                    // 20px box with the 8px radius-sm reads as a rounded SQUARE (a
+                    // multi-select check), where 16px went fully round and
+                    // read as a radio button (Wickens 3, top-down processing).
+                    'flex h-5 w-5 shrink-0 items-center justify-center rounded-[var(--radius-sm)] border',
+                    isSelected
+                      ? 'border-[var(--color-accent)] bg-[var(--color-accent)] text-[var(--color-accent-ink)]'
+                      : 'border-[var(--color-bar-neutral)]',
+                  ].join(' ')}
+                  aria-hidden="true"
+                >
+                  {isSelected && <CheckIcon />}
+                </span>
+                <span
+                  className="adp-mono min-w-0 flex-1 break-words"
+                  style={{ color: 'var(--color-ink)' }}
+                >
+                  {option.label}
+                </span>
+                <span
+                  className="adp-mono shrink-0 tabular-nums"
+                  style={{ color: 'var(--color-ink-faint)' }}
+                  aria-label={`${option.count} ${option.count === 1 ? 'game' : 'games'}`}
+                >
+                  {option.count}
+                </span>
+              </button>
+            </li>
+          );
+        })}
+      </ul>
+      {overflow && (
+        <button
+          type="button"
+          aria-expanded={expanded}
+          aria-controls={`${id}-options`}
+          onClick={() => setExpanded((v) => !v)}
+          className="adp-mono mt-1 min-h-[44px] rounded-[var(--radius-button)] px-3 underline-offset-2 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
+          style={{ color: 'var(--color-accent-text)' }}
+        >
+          {expanded ? 'Show fewer' : `Show all ${options.length} ${noun}`}
+        </button>
+      )}
+    </fieldset>
+  );
+}
+
+export default function GameFilterPanel({
+  facets,
+  filters,
+  onToggle,
+  idPrefix = 'game-filters',
+}: GameFilterPanelProps): React.JSX.Element {
+  if (!facets.ok) {
+    return (
+      <div className="flex flex-col gap-2" data-testid="game-filters-unavailable">
+        <p className="adp-kicker">Filters</p>
+        <p className="adp-body" style={{ color: 'var(--color-ink-sub)' }}>
+          Filters are unavailable right now. The list below is still complete.
+        </p>
+        <InlineError>{facets.message}</InlineError>
+      </div>
+    );
+  }
+
+  const platforms = platformOptions(facets.facets, filters.platforms);
+  const studios = studioOptions(facets.facets, filters.studios);
+  // A facet whose only option is "No platform" (or one studio) filters
+  // nothing, so it is not offered - unless something in it is selected.
+  const namedPlatforms = platforms.filter((o) => o.value !== GAMES_NO_PLATFORM);
+  const showPlatforms = namedPlatforms.length > 0 || filters.platforms.length > 0;
+  const showStudios = studios.length > 1 || filters.studios.length > 0;
+
+  if (!showPlatforms && !showStudios) {
+    return (
+      <div className="flex flex-col gap-2" data-testid="game-filters-empty">
+        <p className="adp-kicker">Filters</p>
+        <p className="adp-body" style={{ color: 'var(--color-ink-sub)' }}>
+          No platforms have been set on these games yet. Admins can add one
+          from a game&apos;s Edit page.
+        </p>
+      </div>
+    );
+  }
+
+  return (
+    <div className="flex flex-col gap-6">
+      {showPlatforms && (
+        <FacetGroup
+          id={`${idPrefix}-platform`}
+          legend="Platform"
+          noun="platforms"
+          options={platforms}
+          selected={filters.platforms}
+          onToggle={(value) => onToggle('platforms', value)}
+        />
+      )}
+      {showStudios && (
+        <FacetGroup
+          id={`${idPrefix}-studio`}
+          legend="Studio"
+          noun="studios"
+          options={studios}
+          selected={filters.studios}
+          onToggle={(value) => onToggle('studios', value)}
+        />
+      )}
+    </div>
+  );
+}
