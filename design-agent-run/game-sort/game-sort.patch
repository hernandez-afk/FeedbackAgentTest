+                  ? 'border-[var(--color-accent)] font-semibold'
+                  : 'border-[var(--color-hair)] hover:border-[var(--color-accent)] hover:bg-[var(--color-accent-08)]',
+              ].join(' ')}
+              style={
+                active
+                  ? { background: 'var(--color-accent)', color: 'var(--color-accent-ink)' }
