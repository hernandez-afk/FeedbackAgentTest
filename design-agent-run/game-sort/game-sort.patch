   if (sort !== GAMES_SORT_DEFAULT) params.set('sort', sort);
   appendFilters(params, filters);
   if (view !== GAMES_VIEW_DEFAULT) params.set('view', view);
+  // Any change of search/sort/filter/view resets to page 1 (callers pass no
+  // page); only the pager passes one.
+  if (page > 1) params.set('page', String(page));
   const qs = params.toString();
   return qs.length > 0 ? `/games?${qs}` : '/games';
 }
