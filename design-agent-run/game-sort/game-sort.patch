+      { id: 'a', title: 'A', franchise_id: 'f', franchise_name: 'Asteroids' },
+      { id: 'b', title: 'B' },
+      { id: 'c', title: 'C', franchise_id: 'f', franchise_name: 'Asteroids' },
+      { id: 'd', title: 'D', franchise_id: 'solo', franchise_name: 'Solo' },
+    ] as Game[];
+    const entries = groupByTitle(games);
+    expect(entries.map((e) => (e.kind === 'title' ? `T:${e.name}` : e.game.id))).toEqual(['T:Asteroids', 'b', 'd']);
