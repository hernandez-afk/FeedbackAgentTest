+'use client';
+
+/**
+ * TitleGroup - several versions of one TITLE shown as one entry (GFE-SORT,
+ * option A). "Asteroids · 3 versions", expanding to the versions themselves.
+ *
+ * The versions are rendered by the SAME components as any other game
+ * (GameCard in card view, GameListRow in list view), passed in as children,
+ * so a version never looks or behaves differently from a stand-alone game
+ * (Consistency; Wickens 13).
+ *
+ * Card view: COLLAPSED it is one card-sized tile in the grid (it claims the
+ * same 7 row tracks as a GameCard, so it sits in a row like any sibling);
+ * EXPANDED it spans the whole row and holds its own inner grid, so each
+ * version card keeps the row-subgrid alignment of DESIGN_SYSTEM §3.10. A
+ * full-row group while collapsed left empty cells beside the card before it
+ * (seen in the first round of screenshots), so width follows state.
+ *
+ * Collapsed by default ("expanding it lists each version"); the collapsed
+ * tile still names every version, so nothing needs opening just to see what
+ * is inside (Wickens 11). The header is a <button> with aria-expanded /
+ * aria-controls, the Collapsible primitive's contract.
+ */
+import { useId, useState, type ReactNode } from 'react';
+import Badge from '@/components/primitives/Badge';
+import CriticalFlag from '@/components/catalog/CriticalFlag';
+import type { Game } from '@/lib/types';
+
+export type TitleGroupProps = {
+  name: string;
+  games: Game[];
+  view: 'card' | 'list';
+  children: ReactNode;
+  defaultOpen?: boolean;
+};
+
+export default function TitleGroup({
+  name,
+  games,
+  view,
+  children,
+  defaultOpen = false,
+}: TitleGroupProps): React.JSX.Element {
+  const [open, setOpen] = useState(defaultOpen);
+  const panelId = useId();
+  const anyCritical = games.some((g) => g.has_critical === true);
+
+  const Wrapper = view === 'list' ? 'li' : 'div';
+  return (
+    <Wrapper
+      className={[
+        'flex flex-col rounded-[var(--radius-lg)] border border-[var(--color-hair)] p-4',
+        view === 'card' ? (open ? 'sm:col-span-2 lg:col-span-3' : 'sm:row-span-7') : '',
+      ].join(' ')}
+      style={{ background: 'var(--color-surface-2)' }}
+      aria-label={`${name}, ${games.length} versions`}
+      data-testid="title-group"
+      data-open={open || undefined}
+    >
+      <button
+        type="button"
+        aria-expanded={open}
+        aria-controls={panelId}
+        onClick={() => setOpen((v) => !v)}
+        className="flex w-full min-h-[44px] items-start justify-between gap-3 rounded-[var(--radius-button)] text-left transition-colors hover:text-[var(--color-accent-text)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
+      >
+        <span className="flex min-w-0 flex-col gap-2">
+          <span className="flex flex-wrap items-center gap-2">
+            <span className="adp-h2 break-words" style={{ color: 'var(--color-ink)' }}>
+              {name}
+            </span>
+            <Badge variant="neutral" size="sm" pill={false}>
+              {games.length} versions
+            </Badge>
+            {anyCritical && <CriticalFlag variant="full" />}
+          </span>
+          <span className="adp-mono break-words" style={{ color: 'var(--color-ink-faint)' }}>
+            {games.map((g) => g.title).join(' · ')}
+          </span>
+          <span className="adp-kicker" style={{ color: 'var(--color-accent-text)' }}>
+            {open ? 'Hide versions' : 'Show versions'}
+          </span>
+        </span>
+        <svg
+          viewBox="0 0 16 16"
+          width="14"
+          height="14"
+          fill="none"
+          stroke="currentColor"
+          strokeWidth="1.75"
+          aria-hidden="true"
+          focusable="false"
+          className={`mt-1 shrink-0 transition-transform ${open ? 'rotate-180' : ''}`}
+          style={{ color: 'var(--color-ink-sub)' }}
+        >
+          <path d="M4 6 L8 10 L12 6" strokeLinecap="round" strokeLinejoin="round" />
+        </svg>
+      </button>
+      <div id={panelId} hidden={!open}>
+        {view === 'list' ? (
+          <ul className="mt-3 flex flex-col gap-3">{children}</ul>
+        ) : (
+          <div className="mt-3 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">{children}</div>
+        )}
+      </div>
+    </Wrapper>
+  );
+}
