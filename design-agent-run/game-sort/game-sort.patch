+/**
+ * CriticalFlag - "reviews have turned overly negative" (GFE-SORT).
+ *
+ * Acceptance criterion: "Critical warning: when reviews become overly
+ * negative". Server-computed (GameOut/NavGame `has_critical`: the latest
+ * sentiment report is >= 40% negative over >= 5 reviews). Only reviewers
+ * ever receive true; everyone else gets null and sees nothing.
+ *
+ * Two cues besides color (Wickens 4): the "!" glyph and, in the `full`
+ * variant, words. The compact variant (sidebar tree, Andreas Beijer's red
+ * "!") carries the words for screen readers and the sidebar's legend line
+ * explains the glyph on screen (Wickens 11).
+ */
+import Badge from '@/components/primitives/Badge';
+
+export const CRITICAL_LABEL = 'Reviews overly negative';
+
+export default function CriticalFlag({
+  variant = 'compact',
+}: {
+  variant?: 'compact' | 'full';
+}): React.JSX.Element {
+  if (variant === 'full') {
+    return (
+      // Short visible words: Badge text never wraps (whitespace-nowrap), and
+      // the full phrase overflowed a 320px row by 33px. The full phrase is
+      // still the accessible name.
+      <Badge variant="negative" size="sm" pill={false} className="shrink-0" aria-label={CRITICAL_LABEL}>
+        ! Negative reviews
+      </Badge>
+    );
+  }
+  return (
+    <span
+      className="inline-flex h-5 min-w-5 shrink-0 items-center justify-center rounded-[var(--radius-sm)] px-1 adp-mono font-bold"
+      style={{ background: 'var(--color-negative)', color: 'var(--color-accent-ink)' }}
+      role="img"
+      aria-label={CRITICAL_LABEL}
+      data-testid="critical-flag"
+    >
+      !
+    </span>
+  );
+}
