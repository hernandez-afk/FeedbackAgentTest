+    assert [g["title"] for g in rows] == ["Badly Reviewed", "Few Reviews", "Fine Reviews"]  # title order
+
+
+@pytest.mark.asyncio
+async def test_navigation_is_scoped_and_complete(app):
+    client, _ = app
