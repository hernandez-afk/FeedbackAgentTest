diff --git a/frontend/components/catalog/CatalogShell.tsx b/frontend/components/catalog/CatalogShell.tsx
new file mode 100644
index 0000000..956c5a7
--- /dev/null
+++ b/frontend/components/catalog/CatalogShell.tsx
@@ -0,0 +1,166 @@
+'use client';
+
+/**
+ * CatalogShell - sidebar + content layout for the catalogue (GFE-SORT).
+ *
+ * After Andreas Beijer's design: a persistent left sidebar (search, sort,
+ * filters, the Project -> Platform -> game tree) beside the page content, on
+ * /games AND on a game's dashboard, so moving between games never means
+ * going back to the list.
+ *
+ * Widths (phone first):
+ *  - below `lg:` the sidebar is a DRAWER: a "Browse & filter" button opens it
+ *    from the left over a backdrop. The author asked for whatever is most
+ *    functional; with a full tree in it, a drawer beats pushing the list a
+ *    screen down (the round-1 inline panel). It is a modal dialog while open:
+ *    focus moves in, Tab is trapped, Escape / the backdrop / Close shut it,
+ *    focus returns to the button, and the page behind does not scroll.
+ *  - from `lg:` it is columns 1-3 of the 12-column grid (manifest
+ *    layout.gridColumns, audit round 1), sticky, scrolling on its own.
+ *
+ * The sidebar is rendered ONCE and restyled by breakpoint (no duplicate ids,
+ * one set of state), and closes itself when the route changes.
+ */
+import { useEffect, useRef, useState, type ReactNode } from 'react';
+import { usePathname, useSearchParams } from 'next/navigation';
+
+export type CatalogShellProps = {
+  sidebar: ReactNode;
+  children: ReactNode;
+  /** Active filter count, shown on the phone button. */
+  activeCount?: number;
+};
+
+function MenuIcon(): React.JSX.Element {
+  return (
+    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" strokeWidth="1.5" aria-hidden="true" focusable="false">
+      <path d="M2.5 4h11 M4.5 8h7 M6.5 12h3" strokeLinecap="round" />
+    </svg>
+  );
+}
+
+export default function CatalogShell({
+  sidebar,
+  children,
+  activeCount = 0,
+}: CatalogShellProps): React.JSX.Element {
+  const [open, setOpen] = useState(false);
+  const panelRef = useRef<HTMLDivElement>(null);
+  const triggerRef = useRef<HTMLButtonElement>(null);
+  const pathname = usePathname();
+  const searchParams = useSearchParams();
+  const routeKey = `${pathname}?${searchParams?.toString() ?? ''}`;
+  const [lastRoute, setLastRoute] = useState(routeKey);
+
+  // Navigating (a tree link, a filter) closes the drawer. Render-time adjust.
+  if (routeKey !== lastRoute) {
+    setLastRoute(routeKey);
+    if (open) setOpen(false);
+  }
+
+  useEffect(() => {
+    if (!open) return;
+    const panel = panelRef.current;
+    const trigger = triggerRef.current;
+    const previousOverflow = document.body.style.overflow;
+    document.body.style.overflow = 'hidden';
+    panel?.querySelector<HTMLElement>('[data-drawer-close]')?.focus();
+
+    function onKey(e: KeyboardEvent): void {
+      if (e.key === 'Escape') {
+        setOpen(false);
+        return;
+      }
+      if (e.key !== 'Tab' || !panel) return;
+      const focusable = Array.from(
+        panel.querySelectorAll<HTMLElement>(
+          'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])',
+        ),
+      ).filter((el) => !el.closest('[hidden]'));
+      if (focusable.length === 0) return;
+      const first = focusable[0]!;
+      const last = focusable[focusable.length - 1]!;
+      if (e.shiftKey && document.activeElement === first) {
+        e.preventDefault();
+        last.focus();
+      } else if (!e.shiftKey && document.activeElement === last) {
+        e.preventDefault();
+        first.focus();
+      }
+    }
+    document.addEventListener('keydown', onKey);
+    return () => {
+      document.removeEventListener('keydown', onKey);
+      document.body.style.overflow = previousOverflow;
+      trigger?.focus();
+    };
+  }, [open]);
+
+  return (
+    <div className="flex flex-col gap-4 lg:grid lg:grid-cols-12 lg:items-start lg:gap-8">
+      <div className="lg:hidden">
+        <button
+          ref={triggerRef}
+          type="button"
+          aria-expanded={open}
+          aria-controls="catalog-sidebar"
+          onClick={() => setOpen(true)}
+          className="adp-mono inline-flex min-h-[44px] items-center gap-2 rounded-[var(--radius-button)] border border-[var(--color-hair)] bg-(--color-surface) px-4 text-[0.75rem] transition-colors hover:border-[var(--color-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
+          style={{ color: 'var(--color-ink)' }}
+        >
+          <MenuIcon />
+          {activeCount > 0 ? `Browse & filter (${activeCount})` : 'Browse & filter'}
+        </button>
+      </div>
+
+      {open && (
+        <div
+          className="adp-reveal fixed inset-0 z-40 lg:hidden"
+          style={{ background: 'var(--color-ink)', opacity: 0.32 }}
+          onClick={() => setOpen(false)}
+          aria-hidden="true"
+          data-testid="drawer-backdrop"
+        />
+      )}
+
+      <aside
+        id="catalog-sidebar"
+        aria-label="Browse and filter games"
+        className={[
+          open
+            ? 'adp-reveal fixed inset-y-0 left-0 z-50 block w-[min(22rem,88vw)] overflow-y-auto p-4 shadow-(--shadow-hi)'
+            : 'hidden',
+          'lg:static lg:z-auto lg:col-span-3 lg:block lg:w-auto lg:overflow-visible lg:p-0 lg:shadow-none',
+          'lg:sticky lg:top-6',
+        ].join(' ')}
+        style={open ? { background: 'var(--color-bg)' } : undefined}
+      >
+        <div
+          ref={panelRef}
+          role={open ? 'dialog' : undefined}
+          aria-modal={open || undefined}
+          aria-label={open ? 'Browse and filter games' : undefined}
+          className="flex flex-col gap-5"
+        >
+          {open && (
+            <div className="flex items-center justify-between lg:hidden">
+              <p className="adp-kicker">Browse &amp; filter</p>
+              <button
+                type="button"
+                data-drawer-close
+                onClick={() => setOpen(false)}
+                className="adp-mono min-h-[44px] rounded-[var(--radius-button)] border border-[var(--color-hair)] px-4 text-[0.75rem] transition-colors hover:border-[var(--color-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
+                style={{ color: 'var(--color-ink)' }}
+              >
+                Close
+              </button>
+            </div>
+          )}
+          {sidebar}
+        </div>
+      </aside>
+
+      <div className="min-w-0 lg:col-span-9">{children}</div>
+    </div>
+  );
+}
