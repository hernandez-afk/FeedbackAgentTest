+'use client';
+
+/**
+ * GroupingFields - the Project + Title inputs on the add/edit game forms
+ * (GFE-SORT).
+ *
+ * Both are optional free text with suggestions: typing a name that exists
+ * (in any capitalisation) joins it, a new name creates it - the backend
+ * gets-or-creates case-insensitively, so "andreas sketches" can never split
+ * a project in two (the author's "should be the same" rule). Suggestions come
+ * from the caller's own visible catalogue (GET /api/games/navigation) via a
+ * native <datalist>: keyboard- and touch-friendly, no custom combobox.
+ *
+ * The suggestion read is this component's own effect so the forms that host
+ * it keep their "no data fetching in the form" rule; a failed read only
+ * means no suggestions.
+ */
+import { useEffect, useState } from 'react';
+import Input from '@/components/primitives/Input';
+import { listGroupingNames } from '@/lib/catalog-api';
+
+export type GroupingFieldsProps = {
+  idPrefix: string;
+  labelClass: string;
+  optionalHint: React.ReactNode;
+  project: string;
+  onProjectChange: (value: string) => void;
+  franchise: string;
+  onFranchiseChange: (value: string) => void;
+};
+
+export default function GroupingFields({
+  idPrefix,
+  labelClass,
+  optionalHint,
+  project,
+  onProjectChange,
+  franchise,
+  onFranchiseChange,
+}: GroupingFieldsProps): React.JSX.Element {
+  const [names, setNames] = useState<{ projects: string[]; titles: string[] }>({
+    projects: [],
+    titles: [],
+  });
+
+  useEffect(() => {
+    let alive = true;
+    listGroupingNames()
+      .then((n) => {
+        if (alive) setNames(n);
+      })
+      .catch(() => {
+        /* suggestions are optional */
+      });
+    return () => {
+      alive = false;
+    };
+  }, []);
+
+  return (
+    <>
+      <div>
+        <label htmlFor={`${idPrefix}-project`} className={labelClass}>
+          Project {optionalHint}
+        </label>
+        <Input
+          id={`${idPrefix}-project`}
+          value={project}
+          onChange={(e) => onProjectChange(e.target.value)}
+          list={`${idPrefix}-project-options`}
+          placeholder="What it's for, e.g. Azerion H5 games"
+          maxLength={128}
+          autoComplete="off"
+          className="mt-2"
+        />
+        <datalist id={`${idPrefix}-project-options`}>
+          {names.projects.map((n) => (
+            <option key={n} value={n} />
+          ))}
+        </datalist>
+      </div>
+      <div>
+        <label htmlFor={`${idPrefix}-franchise`} className={labelClass}>
+          Title {optionalHint}
+        </label>
+        <Input
+          id={`${idPrefix}-franchise`}
+          value={franchise}
+          onChange={(e) => onFranchiseChange(e.target.value)}
+          list={`${idPrefix}-franchise-options`}
+          placeholder="The game this is a version of, e.g. Asteroids"
+          maxLength={128}
+          autoComplete="off"
+          aria-describedby={`${idPrefix}-franchise-help`}
+          className="mt-2"
+        />
+        <p id={`${idPrefix}-franchise-help`} className="adp-mono mt-1" style={{ color: 'var(--color-ink-faint)' }}>
+          Games with the same title are shown together as its versions.
+        </p>
+        <datalist id={`${idPrefix}-franchise-options`}>
+          {names.titles.map((n) => (
+            <option key={n} value={n} />
+          ))}
+        </datalist>
+      </div>
+    </>
+  );
+}
