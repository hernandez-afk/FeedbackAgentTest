+}
+
+// Andreas Beijer's reference tree.
+const ITEMS: NavGame[] = [
+  nav('Asteroids Classics Plus', { platform: 'HTML5', project_id: 'p1', project_name: 'Andreas Sketches', is_favorite: true, has_critical: true }),
