+    expect(current.textContent).toBe('Lunar Taxi');
+    expect(current.getAttribute('href')).toBe('/games/Lunar%20Taxi/dashboard');
+    expect(c.querySelectorAll('[data-testid="critical-flag"]').length).toBe(2); // PopopoP + legend
+    expect(c.querySelector('[aria-label="Unstar Lunar Taxi"]')?.getAttribute('aria-pressed')).toBe('true');
+    expect(c.textContent).toContain('Asteroids · 2 versions');
+  });
+
+  it('narrows to matching titles and says when nothing matches', () => {
+    const c = mount(<CatalogTree items={ITEMS} filterText="lunar" />);
+    expect(Array.from(c.querySelectorAll('[data-testid="tree-game"]')).map((li) => li.textContent)).toEqual(['Lunar Taxi']);
+    const none = mount(<CatalogTree items={ITEMS} filterText="zzz" />);
+    expect(none.querySelector('[data-testid="tree-no-match"]')).not.toBeNull();
+  });
+
+  it('collapses a project', () => {
+    const c = mount(<CatalogTree items={ITEMS} />);
+    const header = Array.from(c.querySelectorAll('button[aria-expanded]')).find((b) => b.textContent === 'Andreas Sketches')!;
+    act(() => header.dispatchEvent(new MouseEvent('click', { bubbles: true })));
+    expect(header.getAttribute('aria-expanded')).toBe('false');
+    expect(c.querySelector(`#${header.getAttribute('aria-controls')}`)?.hasAttribute('hidden')).toBe(true);
+  });
+});
+
+describe('StarButton', () => {
+  it('stars optimistically, calls PUT, and refreshes', async () => {
+    const fetchMock = vi.fn(async () => new Response(null, { status: 204 }));
+    vi.stubGlobal('fetch', fetchMock);
+    const c = mount(<StarButton gameId="g1" gameTitle="Pong" starred={false} />);
+    const btn = c.querySelector('button')!;
+    await act(async () => {
+      btn.dispatchEvent(new MouseEvent('click', { bubbles: true }));
+    });
+    expect(fetchMock).toHaveBeenCalledWith('/api/games/g1/favorite', { method: 'PUT' });
+    expect(btn.getAttribute('aria-pressed')).toBe('true');
+    expect(refreshMock).toHaveBeenCalled();
+    vi.unstubAllGlobals();
+  });
+
+  it('reverts and announces when the request fails', async () => {
+    vi.stubGlobal('fetch', vi.fn(async () => new Response(null, { status: 500 })));
+    const c = mount(<StarButton gameId="g1" gameTitle="Pong" starred />);
+    const btn = c.querySelector('button')!;
+    await act(async () => {
