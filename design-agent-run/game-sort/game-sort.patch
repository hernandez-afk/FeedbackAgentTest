@@ -0,0 +1,81 @@
+'use client';
+
+/**
+ * SortButtons - the sidebar sort row (GFE-SORT, after Andreas Beijer's
+ * "sorting icons: alphabetical, date, starred, critical" row, plus the
+ * brief's "Most active").
+ *
+ * Each option is icon + visible word, 44px tall, aria-pressed: icons alone
+ * were the sketch, but an unlabelled icon row fails discriminability and
+ * "knowledge in the world" (Wickens 5, 11), so the word stays. The group has
+ * a visible "Sort" kicker so it can never be mistaken for the View switch
+ * (audit round 1, Wickens 5). "Critical" is offered to reviewers only: for
+ * anyone else the backend orders it by title, so the button would lie.
+ */
+import type { GamesSort } from '@/lib/game-search';
+import { StarIcon } from '@/components/catalog/StarButton';
+
+type Option = { value: GamesSort; label: string; icon: React.ReactNode };
+
+function Icon({ d }: { d: string }): React.JSX.Element {
+  return (
+    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true" focusable="false">
+      <path d={d} />
+    </svg>
+  );
+}
+
+const OPTIONS: Option[] = [
+  { value: 'title', label: 'A to Z', icon: <Icon d="M2.5 12.5 L5 4 L7.5 12.5 M3.3 10 H6.7 M10 4.5 H13.5 L10 11.5 H13.5" /> },
+  { value: 'newest', label: 'Newest', icon: <Icon d="M8 2.5 A5.5 5.5 0 1 0 8 13.5 A5.5 5.5 0 1 0 8 2.5 M8 5 V8 L10 9.5" /> },
+  { value: 'activity', label: 'Active', icon: <Icon d="M1.5 8.5 H4.5 L6.5 3.5 L9.5 12.5 L11.5 8.5 H14.5" /> },
+  { value: 'starred', label: 'Starred', icon: <StarIcon filled={false} /> },
+  { value: 'critical', label: 'Critical', icon: <Icon d="M8 2 L14.5 13.5 H1.5 Z M8 6.5 V9.5 M8 11.5 V11.6" /> },
+];
+
+export default function SortButtons({
+  sort,
+  onChange,
+  canReview,
+}: {
+  sort: GamesSort;
+  onChange: (sort: GamesSort) => void;
+  canReview: boolean;
+}): React.JSX.Element {
+  const options = OPTIONS.filter((o) => o.value !== 'critical' || canReview);
+  return (
+    <div>
+      <p className="adp-kicker mb-2" aria-hidden="true">
+        Sort
+      </p>
+      <div role="group" aria-label="Sort games" className="flex flex-wrap gap-2">
+        {options.map((option) => {
+          const active = option.value === sort;
+          return (
+            <button
+              key={option.value}
+              type="button"
