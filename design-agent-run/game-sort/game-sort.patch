+'use client';
+
+/**
+ * DashboardSidebar - the catalogue sidebar on a game's dashboard (GFE-SORT,
+ * after Andreas Beijer's design: the same tree beside the dashboard, with the
+ * open game highlighted, so a reviewer can hop game to game).
+ *
+ * Same parts as the /games sidebar, minus the facet filters (they narrow a
+ * list this page does not show):
+ *  - Search: typing narrows the tree at once (a title match, the same one
+ *    the backend's `q` uses); Enter opens /games with that search, so the
+ *    full results are one key away.
+ *  - Sort: `?sort=` on THIS page, which orders the tree (the page re-reads
+ *    GET /api/games/navigation with it). The dashboard reads no `sort`
+ *    param of its own, so the two never collide.
+ *  - The tree, `activeGameId` marked aria-current="page".
+ */
+import { useState, useTransition } from 'react';
+import { usePathname, useRouter, useSearchParams } from 'next/navigation';
+import Input from '@/components/primitives/Input';
+import CatalogTree from '@/components/catalog/CatalogTree';
+import SortButtons from '@/components/catalog/SortButtons';
+import {
+  GAME_SEARCH_MAX_CHARS,
+  GAMES_SORT_DEFAULT,
+  gamesHref,
+  type GameNavigation,
+  type GamesSort,
+} from '@/lib/game-search';
+
+export type DashboardSidebarProps = {
+  navigation: GameNavigation | null;
+  sort: GamesSort;
+  activeGameId: string;
+  canReview: boolean;
+};
+
+export default function DashboardSidebar({
+  navigation,
+  sort,
+  activeGameId,
+  canReview,
+}: DashboardSidebarProps): React.JSX.Element {
+  const router = useRouter();
+  const pathname = usePathname();
+  const searchParams = useSearchParams();
+  const [text, setText] = useState('');
+  const [, startTransition] = useTransition();
+
+  function setSort(next: GamesSort): void {
+    const params = new URLSearchParams(searchParams?.toString() ?? '');
+    if (next === GAMES_SORT_DEFAULT) params.delete('sort');
+    else params.set('sort', next);
+    const qs = params.toString();
+    startTransition(() => router.replace(qs ? `${pathname}?${qs}` : pathname, { scroll: false }));
+  }
+
+  return (
+    <>
+      <form
+        role="search"
+        onSubmit={(e) => {
+          e.preventDefault();
+          router.push(gamesHref(text, sort));
+        }}
+      >
+        <label htmlFor="dashboard-game-search" className="sr-only">
+          Search games by title
+        </label>
+        <Input
+          id="dashboard-game-search"
+          type="search"
+          value={text}
+          maxLength={GAME_SEARCH_MAX_CHARS}
+          autoComplete="off"
+          placeholder="Search games"
+          onChange={(e) => setText(e.target.value)}
+          className="h-11 w-full"
+        />
+      </form>
+      <SortButtons sort={sort} onChange={setSort} canReview={canReview} />
+      <section aria-labelledby="dashboard-browse-heading" className="flex flex-col gap-3">
+        <h2 id="dashboard-browse-heading" className="adp-kicker">
+          Browse
+        </h2>
+        {navigation ? (
+          <CatalogTree
+            items={navigation.items}
+            truncated={navigation.truncated}
+            activeGameId={activeGameId}
+            canReview={canReview}
+            filterText={text}
+          />
+        ) : (
+          <p className="adp-body" style={{ color: 'var(--color-ink-sub)' }}>
+            The game list is unavailable right now.
+          </p>
+        )}
+      </section>
+    </>
+  );
+}
