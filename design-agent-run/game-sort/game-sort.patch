+import type { Meta, StoryObj } from '@storybook/react';
+import { useState } from 'react';
+import GameFilterPanel, { type FacetsState } from './GameFilterPanel';
+import { toggleGameFilter, type GameFilters } from '@/lib/game-search';
+
+const FACETS: FacetsState = {
+  ok: true,
+  facets: {
+    platforms: [
+      { value: 'Atari Recharged', count: 9 },
+      { value: 'MSN', count: 4 },
+      { value: 'Nintendo Switch', count: 3 },
+      { value: 'Web', count: 2 },
+      { value: null, count: 11 },
+    ],
+    studios: [
+      { id: '11111111-1111-4111-8111-111111111111', name: 'Atari', count: 20 },
+      { id: '22222222-2222-4222-8222-222222222222', name: 'Coatsink', count: 9 },
+    ],
+  },
+};
+
+function Interactive({ facets, initial }: { facets: FacetsState; initial: GameFilters }) {
+  const [filters, setFilters] = useState(initial);
+  return (
+    <div style={{ maxWidth: 240 }}>
+      <GameFilterPanel
+        facets={facets}
+        filters={filters}
+        onToggle={(facet, value) => setFilters((f) => toggleGameFilter(f, facet, value))}
+      />
+    </div>
+  );
+}
+
+const meta: Meta<typeof Interactive> = {
+  title: 'Games/GameFilterPanel',
+  component: Interactive,
+  parameters: { layout: 'padded' },
+};
+export default meta;
+type Story = StoryObj<typeof Interactive>;
+
+export const Default: Story = { args: { facets: FACETS, initial: { platforms: [], studios: [] } } };
+export const WithSelection: Story = {
+  args: { facets: FACETS, initial: { platforms: ['MSN'], studios: [] } },
+};
+export const ManyPlatforms: Story = {
+  args: {
+    facets: {
+      ok: true,
+      facets: {
+        platforms: Array.from({ length: 14 }, (_, i) => ({ value: `Platform ${i + 1}`, count: 20 - i })),
+        studios: [],
+      },
+    },
+    initial: { platforms: [], studios: [] },
+  },
+};
+export const Unavailable: Story = {
+  args: { facets: { ok: false, message: 'HTTP 503' }, initial: { platforms: [], studios: [] } },
+};
diff --git a/frontend/components/GameFilterPanel.tsx b/frontend/components/GameFilterPanel.tsx
