+// @vitest-environment jsdom
+/**
+ * GFE-SORT: the sidebar tree (Andreas Beijer's design), title grouping on
+ * the page, and the star button.
+ */
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+const { refreshMock } = vi.hoisted(() => ({ refreshMock: vi.fn() }));
+vi.mock('next/navigation', () => ({
+  useRouter: () => ({ push: vi.fn(), replace: vi.fn(), prefetch: vi.fn(), refresh: refreshMock }),
+}));
+
+import { act } from 'react';
+import { createRoot } from 'react-dom/client';
+import CatalogTree, { buildTree } from '@/components/catalog/CatalogTree';
+import StarButton from '@/components/catalog/StarButton';
+import { groupByTitle } from '@/lib/title-groups';
+import type { NavGame } from '@/lib/game-search';
+import type { Game } from '@/lib/types';
+
+function nav(over: Partial<NavGame>): NavGame {
+  return {
+    id: over.title ?? 'x',
+    title: 'x',
+    slug: null,
+    platform: null,
+    project_id: null,
+    project_name: null,
+    franchise_id: null,
+    franchise_name: null,
+    is_favorite: false,
+    has_critical: null,
+    ...over,
+  };
+}
+
+const ITEMS: NavGame[] = [
+  nav({ title: 'PopopoP', platform: 'ALAN - 9', project_id: 'p1', project_name: 'Andreas Sketches', has_critical: true }),
+  nav({ title: 'Asteroids Arezion (MSN)', platform: 'MSN', project_id: 'p2', project_name: 'Azerion H5 games', franchise_id: 'f1', franchise_name: 'Asteroids' }),
+  nav({ title: 'Asteroids Classic Azerion (MSN)', platform: 'msn', project_id: 'p2', project_name: 'Azerion H5 games', franchise_id: 'f1', franchise_name: 'Asteroids' }),
+  nav({ title: 'Lunar Taxi', platform: 'ALAN - 9', project_id: 'p1', project_name: 'Andreas Sketches', is_favorite: true }),
+  nav({ title: 'Loose game' }),
+];
+
+function mount(el: React.ReactElement): HTMLDivElement {
+  const container = document.createElement('div');
+  document.body.appendChild(container);
+  act(() => createRoot(container).render(el));
+  return container;
+}
+
+beforeEach(() => {
+  refreshMock.mockReset();
+});
+
+describe('buildTree', () => {
+  it('groups Project -> Platform (case-insensitively) -> Title, "No project" last', () => {
+    const tree = buildTree(ITEMS);
+    expect(tree.map((p) => p.label)).toEqual(['Andreas Sketches', 'Azerion H5 games', 'No project']);
+    const azerion = tree[1]!;
+    expect(azerion.platforms).toHaveLength(1); // MSN + msn merged
+    const entry = azerion.platforms[0]!.entries[0]!;
+    expect(entry.kind).toBe('title');
+    expect(entry.kind === 'title' && entry.games.map((g) => g.title)).toEqual([
+      'Asteroids Arezion (MSN)',
+      'Asteroids Classic Azerion (MSN)',
+    ]);
+    expect(tree[2]!.platforms[0]!.label).toBe('No platform');
+  });
+
+  it('keeps the server order of games within a platform', () => {
+    const alan = buildTree(ITEMS)[0]!.platforms[0]!;
+    expect(alan.entries.map((e) => e.kind === 'game' && e.game.title)).toEqual(['PopopoP', 'Lunar Taxi']);
+  });
+});
+
