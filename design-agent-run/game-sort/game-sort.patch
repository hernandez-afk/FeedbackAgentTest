+async def _get_or_create_named(db: AsyncSession, model: Any, name: str) -> uuid.UUID:
+    """Resolve a Project/Franchise by name, case-insensitively, creating it
+    if absent. Race-safe: the unique ``lower(name)`` index decides, and the
+    loser of a concurrent insert re-reads the winner's row."""
+    lookup = select(model.id).where(func.lower(model.name) == name.lower())
+    existing = (await db.execute(lookup)).scalar_one_or_none()
+    if existing is not None:
+        return cast(uuid.UUID, existing)
+    try:
