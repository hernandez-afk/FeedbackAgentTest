@@ -0,0 +1,365 @@
+"""GFE-SORT: catalogue facet filters, the "Most active" sort, and the facets read.
+
+Covers the additive parameters on GET /api/games (``platform``, ``studio``,
+``sort=activity``), the new GET /api/games/facets, and the ``platform`` filter
+on GET /api/sessions.
+
+What is pinned, and why:
+  * a facet filter is applied BEFORE limit/offset (the same guarantee CH-605
+    gives ``q``): a platform whose only game sorts onto page 2 unfiltered is on
+    page 1 filtered. A client-side filter over one page is the tempting wrong
+    implementation;
+  * repeated values OR within a facet, and different facets AND;
+  * ``platform=__none__`` selects games with no platform (most seeded games);
+  * ``sort=activity`` counts only sessions in the window and ignores
+    soft-deleted ones, with a title tiebreak;
+  * the facets read is scoped exactly like the list: a viewer never sees
+    another studio's name or catalogue size in it;
+  * a facet's counts apply the OTHER facet's selection but not its own;
+  * the sessions platform filter narrows ``total`` identically to ``items``.
+
+All tests run against a real (ephemeral) Postgres via db_engine; skipped when
+DATABASE_URL is unset (requires_db mark), same convention as
+test_ch605_games_sort_search.py.
+"""
+from __future__ import annotations
+
+from typing import AsyncGenerator
+
+import httpx
+import pytest
+import pytest_asyncio
+
+from conftest import SEED_ADMIN_EMAIL, requires_db  # type: ignore[import-not-found]
+
+pytestmark = requires_db
+
+BEARER = "Bearer test-secret"
+PAGE_SIZE_DEFAULT = 50
+VIEWER_A_EMAIL = "gfe-sort-viewer-a@atari.com"
+
+
+def _headers(email: str) -> dict[str, str]:
+    from session_token_helper import create_session_token  # type: ignore[import-not-found]
+
+    return {
+        "Authorization": BEARER,
+        "X-Session-Token": create_session_token(email),
+    }
+
+
+@pytest_asyncio.fixture
+async def catalogue_app(db_engine):
+    """Two studios with platforms, filler to force pagination, and sessions.
+
+    Studio A ("Alpha Studio"):
+      * "Asteroids MSN" (MSN), "Centipede MSN" (MSN), "Pong Switch" (Switch),
+      * "zzz MSN Tail" (MSN) — sorts after every filler title, so under the
+        default title ordering it is on page 2 unfiltered,
+      * PAGE_SIZE_DEFAULT filler games with NO platform.
+    Studio B ("Bravo Studio"):
+      * "Tempest MSN B" (MSN) — must never be visible to a studio-A viewer.
+
+    Sessions (for sort=activity and the sessions platform filter):
+      * Pong Switch: 3 recent sessions,
+      * Centipede MSN: 2 recent sessions + 5 soft-deleted recent ones,
+      * Asteroids MSN: 4 sessions, all OUTSIDE the 30-day window.
+    """
+    import datetime as _dt
+
+    import server
+    from backend.db import get_async_db
+    from backend.models import AppUser, Build, Game, Session, Studio, UserRole
+    from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker
+
+    maker = async_sessionmaker(bind=db_engine, expire_on_commit=False, class_=AsyncSession)
+    now = _dt.datetime.now(_dt.timezone.utc)
+
+    def _ago(days: int) -> _dt.datetime:
+        return now - _dt.timedelta(days=days)
+
+    async with maker() as session:
+        studio_a = Studio(name="Alpha Studio")
+        studio_b = Studio(name="Bravo Studio")
+        session.add_all([studio_a, studio_b])
+        await session.flush()
+
+        asteroids = Game(studio_id=studio_a.id, title="Asteroids MSN", platform="MSN")
+        centipede = Game(studio_id=studio_a.id, title="Centipede MSN", platform="MSN")
+        pong = Game(studio_id=studio_a.id, title="Pong Switch", platform="Switch")
+        tail = Game(studio_id=studio_a.id, title="zzz MSN Tail", platform="MSN")
+        filler = [
+            Game(studio_id=studio_a.id, title=f"Filler {i:02d}", platform=None)
+            for i in range(PAGE_SIZE_DEFAULT)
+        ]
+        tempest_b = Game(studio_id=studio_b.id, title="Tempest MSN B", platform="MSN")
+        session.add_all([asteroids, centipede, pong, tail, tempest_b, *filler])
+        await session.flush()
+
+        builds = {}
+        for g in (asteroids, centipede, pong, tempest_b):
+            b = Build(game_id=g.id, label="Checkpoint 1")
+            session.add(b)
+            builds[g.title] = b
+        await session.flush()
+
+        def _sess(game, days: int, deleted: bool = False) -> Session:
+            return Session(
+                game_id=game.id,
+                build_id=builds[game.title].id,
+                submitter_email=VIEWER_A_EMAIL,
+                created_at=_ago(days),
+                deleted_at=_ago(0) if deleted else None,
+            )
+
+        session.add_all(
+            [_sess(pong, d) for d in (1, 2, 3)]
+            + [_sess(centipede, d) for d in (1, 2)]
+            + [_sess(centipede, 1, deleted=True) for _ in range(5)]
+            + [_sess(asteroids, d) for d in (40, 45, 50, 60)]
+            + [_sess(tempest_b, 1)]
+        )
+
+        session.add(AppUser(email=SEED_ADMIN_EMAIL, role=UserRole.admin, studio_id=None))
+        session.add(AppUser(email=VIEWER_A_EMAIL, role=UserRole.viewer, studio_id=studio_a.id))
+        await session.commit()
+        studio_ids = {"A": str(studio_a.id), "B": str(studio_b.id)}
+
+    async def _override_get_async_db() -> AsyncGenerator[AsyncSession, None]:
+        async with maker() as s:
+            yield s
+
+    server.app.dependency_overrides[get_async_db] = _override_get_async_db
+    try:
+
+        def make_client() -> httpx.AsyncClient:
+            transport = httpx.ASGITransport(app=server.app)
+            return httpx.AsyncClient(transport=transport, base_url="http://testserver")
+
+        yield make_client, studio_ids
+    finally:
+        server.app.dependency_overrides.pop(get_async_db, None)
+
+
+async def _games(client, params, email: str = SEED_ADMIN_EMAIL) -> list[dict]:
+    resp = await client.get("/api/games", params=params, headers=_headers(email))
+    assert resp.status_code == 200, resp.text
+    return resp.json()
+
+
+async def _titles(client, params, email: str = SEED_ADMIN_EMAIL) -> list[str]:
+    return [g["title"] for g in await _games(client, params, email)]
+
+
+# ---------------------------------------------------------------------------
+# GET /api/games facet filters
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+async def test_platform_filter_is_applied_before_pagination(catalogue_app):
+    make_client, _ = catalogue_app
+    async with make_client() as client:
+        unfiltered = await _titles(client, {"sort": "title"})
+        filtered = await _titles(client, {"sort": "title", "platform": "MSN"})
+    assert "zzz MSN Tail" not in unfiltered, "fixture no longer pushes the tail off page 1"
+    assert filtered == ["Asteroids MSN", "Centipede MSN", "Tempest MSN B", "zzz MSN Tail"]
+
+
+@pytest.mark.asyncio
+async def test_repeated_platform_values_or_together(catalogue_app):
+    make_client, _ = catalogue_app
+    async with make_client() as client:
+        titles = await _titles(
+            client, [("sort", "title"), ("platform", "MSN"), ("platform", "Switch")]
+        )
+    assert titles == [
+        "Asteroids MSN",
+        "Centipede MSN",
+        "Pong Switch",
+        "Tempest MSN B",
+        "zzz MSN Tail",
+    ]
+
+
+@pytest.mark.asyncio
+async def test_no_platform_sentinel_selects_games_without_a_platform(catalogue_app):
+    make_client, _ = catalogue_app
+    async with make_client() as client:
+        games = await _games(
+            client, {"sort": "title", "platform": "__none__", "page_size": 200}
+        )
+    assert len(games) == PAGE_SIZE_DEFAULT
+    assert all(g["platform"] is None for g in games)
+
+
+@pytest.mark.asyncio
+async def test_studio_filter_and_platform_filter_and_together(catalogue_app):
+    make_client, studios = catalogue_app
+    async with make_client() as client:
+        titles = await _titles(
+            client, {"sort": "title", "platform": "MSN", "studio": studios["B"]}
+        )
+    assert titles == ["Tempest MSN B"]
+
+
+@pytest.mark.asyncio
+async def test_studio_filter_cannot_widen_scope(catalogue_app):
+    """A studio-A viewer asking for studio B's games gets nothing, not B's games."""
+    make_client, studios = catalogue_app
+    async with make_client() as client:
+        titles = await _titles(client, {"studio": studios["B"]}, email=VIEWER_A_EMAIL)
+    assert titles == []
+
+
+@pytest.mark.asyncio
+async def test_response_carries_studio_name_and_created_at(catalogue_app):
+    make_client, _ = catalogue_app
+    async with make_client() as client:
+        games = await _games(client, {"platform": "Switch"})
+    assert len(games) == 1
+    assert games[0]["studio_name"] == "Alpha Studio"
+    assert games[0]["created_at"] is not None
+
+
+@pytest.mark.asyncio
+async def test_too_many_facet_values_is_rejected(catalogue_app):
+    make_client, _ = catalogue_app
+    async with make_client() as client:
+        resp = await client.get(
+            "/api/games",
+            params=[("platform", f"P{i}") for i in range(21)],
+            headers=_headers(SEED_ADMIN_EMAIL),
+        )
+    assert resp.status_code == 422
+
+
+# ---------------------------------------------------------------------------
+# sort=activity
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+async def test_activity_sort_counts_recent_non_deleted_sessions(catalogue_app):
+    """Pong (3 recent) before Centipede (2 recent; its 5 deleted don't count).
+    Asteroids' 4 sessions are all outside the window, so it ties at 0 with every
+    other game and falls back to title order."""
+    make_client, _ = catalogue_app
+    async with make_client() as client:
+        titles = await _titles(client, {"sort": "activity", "platform": "MSN"}, VIEWER_A_EMAIL)
+        all_titles = await _titles(client, {"sort": "activity"}, VIEWER_A_EMAIL)
+    assert titles == ["Centipede MSN", "Asteroids MSN", "zzz MSN Tail"]
+    assert all_titles[:3] == ["Pong Switch", "Centipede MSN", "Asteroids MSN"]
+
+
+@pytest.mark.asyncio
+async def test_activity_sort_response_does_not_expose_counts(catalogue_app):
+    make_client, _ = catalogue_app
+    async with make_client() as client:
+        games = await _games(client, {"sort": "activity", "platform": "Switch"})
+    assert "recent_session_count" not in games[0]
+    assert not any("session" in key for key in games[0])
+
+
+# ---------------------------------------------------------------------------
+# GET /api/games/facets
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+async def test_facets_are_scoped_to_the_callers_studio(catalogue_app):
+    make_client, _ = catalogue_app
+    async with make_client() as client:
+        resp = await client.get("/api/games/facets", headers=_headers(VIEWER_A_EMAIL))
+    assert resp.status_code == 200, resp.text
+    body = resp.json()
+    assert [s["name"] for s in body["studios"]] == ["Alpha Studio"]
+    assert body["platforms"] == [
+        {"value": "MSN", "count": 3},
+        {"value": "Switch", "count": 1},
+        {"value": None, "count": PAGE_SIZE_DEFAULT},
+    ]
+
+
+@pytest.mark.asyncio
+async def test_admin_facets_cover_every_studio(catalogue_app):
+    make_client, _ = catalogue_app
+    async with make_client() as client:
+        body = (await client.get("/api/games/facets", headers=_headers(SEED_ADMIN_EMAIL))).json()
+    assert {s["name"]: s["count"] for s in body["studios"]} == {
+        "Alpha Studio": PAGE_SIZE_DEFAULT + 4,
+        "Bravo Studio": 1,
+    }
+    msn = next(p for p in body["platforms"] if p["value"] == "MSN")
+    assert msn["count"] == 4
+
+
+@pytest.mark.asyncio
+async def test_facet_counts_apply_the_other_facet_but_not_their_own(catalogue_app):
+    """With platform=MSN picked: studio counts are MSN-only, but the platform
+    counts still show Switch (so a second platform can be added), and with a
+    studio picked the platform counts narrow to that studio."""
+    make_client, studios = catalogue_app
+    async with make_client() as client:
+        by_platform = (
+            await client.get(
+                "/api/games/facets", params={"platform": "MSN"}, headers=_headers(SEED_ADMIN_EMAIL)
+            )
+        ).json()
+        by_studio = (
+            await client.get(
+                "/api/games/facets",
+                params={"studio": studios["B"]},
+                headers=_headers(SEED_ADMIN_EMAIL),
+            )
+        ).json()
+    assert {s["name"]: s["count"] for s in by_platform["studios"]} == {
+        "Alpha Studio": 3,
+        "Bravo Studio": 1,
+    }
+    assert {p["value"] for p in by_platform["platforms"]} == {"MSN", "Switch", None}
+    assert by_studio["platforms"] == [{"value": "MSN", "count": 1}]
+
+
+@pytest.mark.asyncio
+async def test_facets_apply_the_search_term(catalogue_app):
+    make_client, _ = catalogue_app
+    async with make_client() as client:
+        body = (
+            await client.get(
+                "/api/games/facets", params={"q": "pong"}, headers=_headers(SEED_ADMIN_EMAIL)
+            )
+        ).json()
+    assert body["platforms"] == [{"value": "Switch", "count": 1}]
+
+
+@pytest.mark.asyncio
+async def test_facets_route_is_not_parsed_as_a_game_id(catalogue_app):
+    make_client, _ = catalogue_app
+    async with make_client() as client:
+        resp = await client.get("/api/games/facets", headers=_headers(SEED_ADMIN_EMAIL))
+    assert resp.status_code == 200
+
+
+# ---------------------------------------------------------------------------
+# GET /api/sessions?platform=
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+async def test_sessions_platform_filter_narrows_items_and_total(catalogue_app):
+    make_client, _ = catalogue_app
+    async with make_client() as client:
+        resp = await client.get(
+            "/api/sessions", params={"platform": "Switch"}, headers=_headers(SEED_ADMIN_EMAIL)
+        )
+        msn = await client.get(
+            "/api/sessions", params={"platform": "MSN"}, headers=_headers(SEED_ADMIN_EMAIL)
+        )
+    assert resp.status_code == 200, resp.text
+    body = resp.json()
+    assert body["total"] == 3
+    assert {row["game"] for row in body["items"]} == {"Pong Switch"}
+    # MSN: Centipede's 2 live + Asteroids' 4 + Tempest B's 1 (admin sees all);
+    # the 5 soft-deleted Centipede sessions stay excluded.
+    assert msn.json()["total"] == 7
